# ============================================
# OZARKROOSTS ENVIRONMENT CONFIGURATION
# ============================================
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@host:5432/ozarkroosts

# Node Environment
NODE_ENV=production
PORT=3000

# ============================================
# AUTONOMOUS SALES ENGINE (NEW)
# ============================================

# Email Account - Send emails from YOUR Gmail account
# 1. Enable 2FA on Gmail
# 2. Go to myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Copy the 16-character password (NOT your Gmail password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=noreply@ozarkroosts.com

# Stripe - Charge customers automatically
# Get keys from: dashboard.stripe.com/apikeys
# Use LIVE keys in production (start with sk_live_ and pk_live_)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxx
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/your-payment-link
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# OpenAI API - Power the AI email/response generation
# Get from: platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# App URL - Where to redirect after payment / canonical SEO base
APP_URL=https://ozarkroost.onrender.com

# Autonomous Mode - Set to "true" to ACTIVATE FULL AUTONOMY
# This enables:
# - Automatic email sending
# - Autonomous prospect replies
# - Contract generation & sending
# - Automatic card charging
# - Billing automation
AUTONOMOUS_MODE=false

# ============================================
# AFFILIATE / MONETIZATION LINKS
# ============================================
# Paste your tracked partner URLs (Stay22, Impact, CJ, etc.)
AFF_STAY22_URL=
AFF_HIPCAMP_URL=
AFF_GETYOURGUIDE_URL=
AFF_VIATOR_URL=
AFF_REI_URL=
AFF_PUBLICLANDS_URL=

# ============================================
# OPTIONAL: Affiliate AI (Already live)
# ============================================
# Leave these as-is, already configured
AFFILIATE_SCAN_INTERVAL=3600000
# ============================================
# SUPERAGENTS (in-code ops)
# ============================================
SITE_HEALTH_ENABLED=true
AFFILIATE_OPS_ENABLED=true
SUPERAGENT_ENABLED=true
# Protect write endpoints (optional)
HEALTH_API_KEY=
OPS_API_KEY=
SITE_HEALTH_INTERVAL_MS=180000
AFFILIATE_OPS_INTERVAL_MS=3600000
# Force affiliate AI scanner outside production
# AFFILIATE_AI_ENABLED=true

# OpsBot + Marketing (optional automation)
OPSBOT_ENABLED=false
MARKETING_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
AUTONOMOUS_API_KEY=
