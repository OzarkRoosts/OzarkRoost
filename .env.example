DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ozarkroost"
PORT="3000"
POLSIA_ANALYTICS_SLUG="ozarkroost"
APP_URL="https://ozartkroost.onrender.com"
SITE_URL="https://ozartkroost.onrender.com"

ADMIN_EMAIL="admin@ozarkroost.com"
ADMIN_PASSWORD="change-this-immediately"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Cold business outreach. Keep separate from subscriber marketing.
OPSBOT_PROACTIVE_OUTREACH="false"
OPSBOT_PROACTIVE_OUTREACH_INTERVAL="900000"

# Mailchimp website subscribers only. Never commit real credentials.
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""
# Owner-Operator Agent
OWNER_AGENT_ENABLED=true
OWNER_AGENT_INTERVAL_MS=60000
OWNER_AGENT_MAX_QUEUE=500
# Optional: persist local agent state outside the repo working tree
# OWNER_AGENT_DATA_DIR=/var/lib/ozarkroost/owner-agent
