# ============================================
# OZARKROOSTS ENVIRONMENT CONFIGURATION
# ============================================
# Copy this to .env and fill in your values

# Database (Neon pooled connection string)
DATABASE_URL=postgresql://user:password@host:5432/ozarkroosts

# Node Environment
NODE_ENV=production
PORT=3000

# App URL - Render public URL or custom domain (no trailing slash)
APP_URL=https://ozarkroost.onrender.com

# ============================================
# EMAIL (Gmail app password recommended)
# Account in use for Base44: theozarkroost@gmail.com
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=theozarkroost@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=OzarkRoost <theozarkroost@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=theozarkroost@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# ============================================
# STRIPE — REVENUE PATH
# ============================================
# Keep secret keys/webhook secrets only in Render or local .env.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Tier-specific Stripe Payment Links. These override the safe in-code fallbacks.
STRIPE_STARTER_PAYMENT_LINK_URL=https://buy.stripe.com/your-starter-link
STRIPE_FEATURED_PAYMENT_LINK_URL=https://buy.stripe.com/your-featured-link
STRIPE_DOMINANT_PAYMENT_LINK_URL=https://buy.stripe.com/your-dominant-link
# Legacy compatibility only.
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/your-payment-link
# Stripe webhook endpoint: https://YOUR-DOMAIN/webhooks/stripe
# Required event: checkout.session.completed

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

AUTONOMOUS_MODE=false

