<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Get Featured on OzarkRoost — Premium Business Listing</title>
  <meta name="description" content="Get your Ozarks business in front of travelers with a premium OzarkRoost listing. Choose Starter, Featured, or Dominant placement and check out securely with Stripe.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,0..40,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <nav class="site-nav"><div class="site-nav__inner"><a href="/" class="site-nav__logo">OzarkRoost</a><div class="site-nav__links"><a href="/listings">Browse</a><a href="/list-your-cabin" class="site-nav__cta">Get Featured</a></div></div></nav>
  <section class="lyc-hero"><div class="lyc-hero__inner"><div class="lyc-hero__badge">For Ozarks Business Owners</div><h1>Get your business in front of Ozarks travelers</h1><p class="lyc-hero__sub">Turn traveler traffic into direct visits and bookings with a premium OzarkRoost listing. Choose your visibility level, submit your business, and check out securely.</p><div class="lyc-hero__stats"><div class="lyc-hero__stat"><span class="lyc-hero__stat-num">$99+</span><span class="lyc-hero__stat-label">premium placement</span></div><div class="lyc-hero__stat"><span class="lyc-hero__stat-num">3</span><span class="lyc-hero__stat-label">visibility levels</span></div><div class="lyc-hero__stat"><span class="lyc-hero__stat-num">Stripe</span><span class="lyc-hero__stat-label">secure checkout</span></div></div></div></section>
  <section class="lyc-form-section"><div class="lyc-form-section__inner">
    <h2>Choose your visibility</h2>
    <div class="lyc-plans" role="radiogroup" aria-label="Premium listing plan"><label class="lyc-plan"><input type="radio" name="plan_choice" value="starter" checked form="listing-form"><span><strong>Starter — $99</strong><small>Premium listing visibility</small></span></label><label class="lyc-plan"><input type="radio" name="plan_choice" value="featured" form="listing-form"><span><strong>Featured — $149</strong><small>More prominent placement for travelers</small></span></label><label class="lyc-plan"><input type="radio" name="plan_choice" value="dominant" form="listing-form"><span><strong>Dominant — $199</strong><small>Maximum premium exposure</small></span></label></div>
    <h2>Tell travelers about your business</h2><p class="lyc-form-section__desc">Cabins, campgrounds, glamping, RV sites, guides, outfitters, restaurants, attractions, and other Ozarks travel businesses can apply.</p>
    <% if (typeof error !== 'undefined' && error) { %><div class="form-error"><%= error %></div><% } %>
    <form id="listing-form" class="lyc-form" method="POST" action="/list-your-cabin"><input type="hidden" id="tier" name="tier" value="<%= typeof tier !== 'undefined' ? tier : 'starter' %>">
      <div class="form-row form-row--two"><div class="form-group"><label for="owner_name">Your Name <span class="required">*</span></label><input type="text" id="owner_name" name="owner_name" required placeholder="Maggie Thornton" value="<%= typeof values !== 'undefined' && values.owner_name ? values.owner_name : '' %>"></div><div class="form-group"><label for="owner_email">Business Email <span class="required">*</span></label><input type="email" id="owner_email" name="owner_email" required placeholder="maggie@ozarkbusiness.com" value="<%= typeof values !== 'undefined' && values.owner_email ? values.owner_email : '' %>"></div></div>
      <div class="form-row form-row--two"><div class="form-group"><label for="property_name">Business / Property Name <span class="required">*</span></label><input type="text" id="property_name" name="property_name" required placeholder="Bull Shoals Lakeside Cabin" value="<%= typeof values !== 'undefined' && values.property_name ? values.property_name : '' %>"></div><div class="form-group"><label for="location">Location <span class="required">*</span></label><input type="text" id="location" name="location" required placeholder="Bull Shoals, AR" value="<%= typeof values !== 'undefined' && values.location ? values.location : '' %>"></div></div>
      <div class="form-group"><label for="property_type">Business Type <span class="required">*</span></label><select id="property_type" name="property_type" required><option value="">Select type…</option><option value="cabin">Cabin / Vacation Rental</option><option value="rv">RV Site / Campground</option><option value="glamping">Glamping</option><option value="restaurant">Restaurant / Bar</option><option value="attraction">Attraction / Show</option><option value="guide">Guide / Outfitter</option><option value="other">Other Ozarks Business</option></select></div>
      <div class="form-group"><label for="description">What makes you worth the trip?</label><textarea id="description" name="description" rows="4" placeholder="Tell travelers what makes your business special."><%= (typeof values !== 'undefined' && values.description) ? values.description : '' %></textarea></div>
      <div class="form-row form-row--two"><div class="form-group"><label for="photo_url">Photo URL</label><input type="url" id="photo_url" name="photo_url" placeholder="https://example.com/photo.jpg"><span class="form-hint">Optional link to a photo of your business.</span></div><div class="form-group"><label for="website_url">Website / Booking Link</label><input type="url" id="website_url" name="website_url" placeholder="https://yourbusiness.com"><span class="form-hint">Where travelers should go to book, visit, or learn more.</span></div></div>
      <div class="lyc-form__footer"><p class="lyc-form__note">You’ll review your details, then continue to secure Stripe Checkout. Payment is processed by Stripe.</p><button type="submit" class="btn btn--primary btn--lg">Get Featured — Continue to Payment →</button></div>
    </form>
  </div></section>
  <section class="lyc-how"><div class="lyc-how__inner"><h2>Three steps to get featured</h2><div class="lyc-how__steps"><div class="lyc-how__step"><div class="lyc-how__step-num">1</div><h3>Submit your business</h3><p>Tell us who you are, where you are, and where travelers can find you.</p></div><div class="lyc-how__step"><div class="lyc-how__step-num">2</div><h3>Pay securely</h3><p>Complete your selected premium plan through Stripe.</p></div><div class="lyc-how__step"><div class="lyc-how__step-num">3</div><h3>Get discovered</h3><p>Your paid listing becomes eligible for premium placement on OzarkRoost.</p></div></div></div></section>
  <%- include('partials/footer') %><script>document.querySelectorAll('input[name="plan_choice"]').forEach((radio) => { radio.addEventListener('change', () => { document.getElementById('tier').value = radio.value; }); });</script>
</body></html>
