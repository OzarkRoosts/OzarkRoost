<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= founding ? 'Founding Spot Claimed' : 'Submission Received' %> — OzarkRoost</title>
  <meta name="description" content="Your OzarkRoost listing submission has been received.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400,0,9..40,500,0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <nav class="site-nav"><div class="site-nav__inner"><a href="/" class="site-nav__logo">OzarkRoost</a><div class="site-nav__links"><a href="/listings">Browse Cabins</a><a href="/list-your-cabin" class="site-nav__cta">List Your Business</a></div></div></nav>
  <section class="ty-hero"><div class="ty-hero__inner"><div class="ty-hero__icon">✓</div><h1><%= founding ? 'Your founding spot is claimed!' : 'Submission received!' %></h1><p class="ty-hero__sub"><%= founding ? 'Thanks for joining OzarkRoost early. Your free founding listing has been submitted for review.' : 'Your property is pending review. Here’s what happens next:' %></p></div></section>
  <section class="ty-body"><div class="ty-body__inner"><div class="ty-card">
    <% if (founding) { %>
      <h2>You’re in the founding group</h2>
      <ol class="ty-steps">
        <li><strong>We review your listing</strong> and make sure the submitted business information is ready for travelers.</li>
        <li><strong>Your founding listing can stay visible for 90 days</strong> under the current founding-offer rules.</li>
        <li><strong>Want more visibility later?</strong> You can return to the listing page and choose an optional paid placement.</li>
      </ol>
      <div class="ty-actions"><a href="/listings" class="btn btn--primary">Explore the Ozarks →</a><a href="/list-your-cabin" class="btn">See Premium Options</a></div>
    <% } else { %>
      <h2>What happens next</h2>
      <ol class="ty-steps"><li><strong>Check your email<% if (email) { %> at <%= email %><% } %></strong> for payment details.</li><li><strong>Your listing goes live</strong> after payment is confirmed.</li><li><strong>Your selected plan renews monthly</strong> through Stripe until cancelled.</li></ol>
      <% if (manual) { %><div class="ty-manual-notice"><strong>Note:</strong> Your payment link couldn’t be generated automatically. Please contact <a href="mailto:ozarkroost@polsia.app">ozarkroost@polsia.app</a> to complete activation.</div><% } %>
      <div class="ty-actions"><a href="/listings" class="btn btn--primary">Browse Ozarks Cabins →</a></div>
    <% } %>
  </div></div></section>
  <%- include('partials/footer') %>
</body></html>
