<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>List Your Property — OzarkRoost</title>
  <meta name="description" content="Get your Arkansas Ozarks cabin, campground, or RV park in front of thousands of annual visitors. $20/month sponsored listing — no commission on bookings.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <%- include('partials/speed-insights') %>
  <style>
    /* =========================================
       Operator Page — Hero
       ========================================= */
    .op-hero {
      background: var(--pine);
      padding: 80px 24px 72px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .op-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 80%, rgba(212,137,63,0.12) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(42,85,64,0.3) 0%, transparent 50%);
      pointer-events: none;
    }
    .op-hero__inner { max-width: 720px; margin: 0 auto; position: relative; }
    .op-hero__badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      background: var(--amber);
      color: white;
      padding: 5px 16px;
      border-radius: 50px;
      margin-bottom: 20px;
    }
    .op-hero h1 {
      font-family: var(--font-display);
      font-size: clamp(34px, 5vw, 56px);
      color: var(--cream);
      font-weight: 400;
      line-height: 1.1;
      margin-bottom: 20px;
    }
    .op-hero h1 em {
      font-style: italic;
      color: var(--amber-light);
    }
    .op-hero__sub {
      font-size: 18px;
      color: rgba(245,240,232,0.72);
      margin-bottom: 44px;
      line-height: 1.6;
    }
    .op-hero__actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* =========================================
       Operator Page — Stats Bar
       ========================================= */
    .op-stats {
      background: var(--pine-dark);
      border-top: 1px solid rgba(245,240,232,0.08);
      padding: 32px 24px;
    }
    .op-stats__inner {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      justify-content: center;
      gap: clamp(32px, 6vw, 72px);
      flex-wrap: wrap;
    }
    .op-stats__item { text-align: center; }
    .op-stats__num {
      display: block;
      font-family: var(--font-display);
      font-size: 32px;
      color: var(--amber-light);
      line-height: 1;
    }
    .op-stats__label {
      display: block;
      font-size: 13px;
      color: rgba(245,240,232,0.5);
      margin-top: 4px;
    }

    /* =========================================
       Operator Page — Benefits
       ========================================= */
    .op-benefits { padding: var(--section-pad) 24px; }
    .op-benefits__inner { max-width: 1000px; margin: 0 auto; }
    .op-benefits__header { text-align: center; margin-bottom: 56px; }
    .op-benefits__header .section-title { margin-bottom: 12px; }
    .op-benefits__header .section-sub { color: var(--text-muted); font-size: 17px; }
    .op-benefits__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 28px;
    }
    .op-benefits__card {
      background: white;
      border-radius: var(--radius-lg);
      padding: 36px 32px;
      box-shadow: 0 2px 16px rgba(28,61,42,0.08);
      border: 1px solid rgba(28,61,42,0.06);
      position: relative;
      overflow: hidden;
    }
    .op-benefits__card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--amber);
    }
    .op-benefits__icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: var(--cream);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      color: var(--pine);
    }
    .op-benefits__card h3 {
      font-family: var(--font-display);
      font-size: 20px;
      color: var(--text-primary);
      margin-bottom: 10px;
      font-weight: 400;
    }
    .op-benefits__card p {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.65;
    }

    /* =========================================
       Operator Page — How It Works
       ========================================= */
    .op-how { padding: var(--section-pad) 24px; background: var(--pine); }
    .op-how__inner { max-width: 900px; margin: 0 auto; }
    .op-how__header { text-align: center; margin-bottom: 52px; }
    .op-how__header .section-title { color: var(--cream); margin-bottom: 12px; }
    .op-how__header .section-sub { color: rgba(245,240,232,0.6); font-size: 17px; }
    .op-how__steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 40px;
    }
    .op-how__step { text-align: center; }
    .op-how__step-num {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--amber);
      color: white;
      font-family: var(--font-display);
      font-size: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }
    .op-how__step h3 {
      font-family: var(--font-display);
      font-size: 18px;
      color: var(--cream);
      margin-bottom: 8px;
      font-weight: 400;
    }
    .op-how__step p {
      font-size: 14px;
      color: rgba(245,240,232,0.6);
      line-height: 1.6;
    }

    /* =========================================
       Operator Page — Pricing Highlight
       ========================================= */
    .op-pricing {
      padding: var(--section-pad) 24px;
      background: var(--cream-dark);
      text-align: center;
    }
    .op-pricing__inner { max-width: 600px; margin: 0 auto; }
    .op-pricing__price {
      font-family: var(--font-display);
      font-size: clamp(48px, 8vw, 72px);
      color: var(--pine);
      line-height: 1;
      margin-bottom: 4px;
    }
    .op-pricing__price span {
      font-size: 24px;
      vertical-align: top;
      font-family: var(--font-body);
      font-weight: 400;
      color: var(--text-muted);
    }
    .op-pricing__desc {
      font-size: 17px;
      color: var(--text-muted);
      margin-bottom: 32px;
    }
    .op-pricing__perks {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 40px;
    }
    .op-pricing__perks li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      color: var(--text-primary);
    }
    .op-pricing__perks li svg { color: var(--amber); flex-shrink: 0; }

    /* =========================================
       Operator Page — Form
       ========================================= */
    .op-form-section { padding: var(--section-pad) 24px; }
    .op-form-section__inner { max-width: 680px; margin: 0 auto; }
    .op-form-section__inner h2 { text-align: center; margin-bottom: 12px; }
    .op-form-section__desc { text-align: center; color: var(--text-muted); font-size: 16px; margin-bottom: 40px; }
    .op-form { display: flex; flex-direction: column; gap: 20px; }
    .op-form .form-row { display: flex; gap: 20px; flex-wrap: wrap; }
    .op-form .form-row--two > * { flex: 1; min-width: 220px; }
    .op-form .form-group { display: flex; flex-direction: column; gap: 6px; }
    .op-form label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-primary);
    }
    .op-form .required { color: var(--amber); }
    .op-form input,
    .op-form select,
    .op-form textarea {
      padding: 12px 16px;
      border: 1.5px solid var(--cream-dark);
      border-radius: var(--radius);
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--text-primary);
      background: white;
      transition: border-color 0.2s, box-shadow 0.2s;
      width: 100%;
    }
    .op-form input:focus,
    .op-form select:focus,
    .op-form textarea:focus {
      outline: none;
      border-color: var(--pine);
      box-shadow: 0 0 0 3px rgba(28,61,42,0.1);
    }
    .op-form input::placeholder,
    .op-form textarea::placeholder { color: #aaa; }
    .op-form textarea { resize: vertical; }
    .op-form__footer { display: flex; flex-direction: column; align-items: center; gap: 12px; padding-top: 8px; }
    .op-form__note { font-size: 13px; color: var(--text-muted); }

    /* Success state */
    .op-success {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      background: #f0f7f2;
      border: 1.5px solid rgba(28,61,42,0.2);
      border-radius: var(--radius-lg);
      padding: 28px 32px;
    }
    .op-success svg { color: var(--pine); flex-shrink: 0; margin-top: 2px; }
    .op-success strong { font-size: 17px; color: var(--text-primary); display: block; margin-bottom: 6px; }
    .op-success p { font-size: 14px; color: var(--text-muted); line-height: 1.6; }
    .form-error { background: #fff5f5; border: 1.5px solid #e53e3e; border-radius: var(--radius); padding: 14px 18px; font-size: 14px; color: #c53030; }
  </style>
</head>
<body>
  <!-- Nav -->
  <nav class="site-nav">
    <div class="site-nav__inner">
      <a href="/" class="site-nav__logo">OzarkRoost</a>
      <div class="site-nav__links">
        <a href="/listings">Browse Cabins</a>
        <a href="/adventures">Adventures</a>
        <a href="/list-your-cabin" class="site-nav__cta">List Your Cabin</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="op-hero">
    <div class="op-hero__inner">
      <div class="op-hero__badge">For Property Operators</div>
      <h1>Get found by <em>thousands</em> of Ozarks visitors</h1>
      <p class="op-hero__sub">Cabin, campground, and RV park owners — list your property on OzarkRoost for just $20/month. No commission on bookings. Cancel anytime.</p>
      <div class="op-hero__actions">
        <a href="#inquiry-form" class="btn btn--primary btn--lg">Get Your Listing</a>
        <a href="#how-it-works" class="btn btn--ghost btn--lg">See How It Works</a>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="op-stats">
    <div class="op-stats__inner">
      <div class="op-stats__item">
        <span class="op-stats__num">52M+</span>
        <span class="op-stats__label">Annual Arkansas tourists</span>
      </div>
      <div class="op-stats__item">
        <span class="op-stats__num">$20</span>
        <span class="op-stats__label">per month, no commission</span>
      </div>
      <div class="op-stats__item">
        <span class="op-stats__num">0%</span>
        <span class="op-stats__label">commission on your bookings</span>
      </div>
      <div class="op-stats__item">
        <span class="op-stats__num">48hr</span>
        <span class="op-stats__label">listing approval turnaround</span>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="op-benefits">
    <div class="op-benefits__inner">
      <div class="op-benefits__header">
        <h2 class="section-title">Why operators choose OzarkRoost</h2>
        <p class="section-sub">We connect outdoor travelers directly with you — no intermediary taking a cut of your bookings.</p>
      </div>
      <div class="op-benefits__grid">
        <div class="op-benefits__card">
          <div class="op-benefits__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </div>
          <h3>Be discovered</h3>
          <p>Your property appears in search results and destination guides seen by hundreds of thousands of Ozarks travelers each year.</p>
        </div>
        <div class="op-benefits__card">
          <div class="op-benefits__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Direct booking inquiries</h3>
          <p>Travelers submit booking inquiries straight to you. You handle payment however you prefer — no platform lock-in.</p>
        </div>
        <div class="op-benefits__card">
          <div class="op-benefits__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3>Featured in curated guides</h3>
          <p>Qualified properties get featured in seasonal guides and adventure content — reaching travelers already planning their trip.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="op-how" id="how-it-works">
    <div class="op-how__inner">
      <div class="op-how__header">
        <h2 class="section-title">Three steps to your listing</h2>
        <p class="section-sub">Takes about 5 minutes. No paperwork. No commitment.</p>
      </div>
      <div class="op-how__steps">
        <div class="op-how__step">
          <div class="op-how__step-num">1</div>
          <h3>Submit your property</h3>
          <p>Fill out the form below with your property name, type, and location. Takes under 2 minutes.</p>
        </div>
        <div class="op-how__step">
          <div class="op-how__step-num">2</div>
          <h3>We build your listing</h3>
          <p>Our team creates a sponsored listing page with photos, amenities, and direct inquiry links — at no extra cost.</p>
        </div>
        <div class="op-how__step">
          <div class="op-how__step-num">3</div>
          <h3>Activate for $20/mo</h3>
          <p>We send you a secure payment link. Activate anytime — your listing goes live immediately after.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing callout -->
  <section class="op-pricing">
    <div class="op-pricing__inner">
      <div class="op-pricing__price">$20<span>/month</span></div>
      <p class="op-pricing__desc">All-inclusive. No platform commission on your bookings.</p>
      <ul class="op-pricing__perks">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          Dedicated listing page with photos and amenities
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          Featured placement in Ozarks destination guides
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          Direct booking inquiry emails — you handle payment
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          Cancel anytime — no contracts, no penalties
        </li>
      </ul>
    </div>
  </section>

  <!-- Inquiry Form -->
  <section class="op-form-section" id="inquiry-form">
    <div class="op-form-section__inner">
      <h2 class="section-title">Submit your property</h2>
      <p class="op-form-section__desc">We'll build your listing and send you a payment link within 48 hours.</p>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="op-success">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <div>
            <strong>Submission received!</strong>
            <p>We'll review your property and send you a listing setup and payment link within 48 hours.</p>
          </div>
        </div>
      <% } else { %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="form-error"><%= error %></div>
        <% } %>
        <form class="op-form" method="POST" action="/operators">
          <div class="form-row form-row--two">
            <div class="form-group">
              <label for="operator_name">Your Name <span class="required">*</span></label>
              <input type="text" id="operator_name" name="operator_name" required placeholder="Maggie Thornton"
                value="<%= typeof values !== 'undefined' && values.operator_name ? values.operator_name : '' %>">
            </div>
            <div class="form-group">
              <label for="email">Email Address <span class="required">*</span></label>
              <input type="email" id="email" name="email" required placeholder="maggie@ozarkcabins.com"
                value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>">
            </div>
          </div>
          <div class="form-row form-row--two">
            <div class="form-group">
              <label for="property_name">Property Name <span class="required">*</span></label>
              <input type="text" id="property_name" name="property_name" required placeholder="Bull Shoals Lakeside Cabin"
                value="<%= typeof values !== 'undefined' && values.property_name ? values.property_name : '' %>">
            </div>
            <div class="form-group">
              <label for="property_type">Property Type <span class="required">*</span></label>
              <select id="property_type" name="property_type" required>
                <option value="">Select type…</option>
                <option value="cabin" <%= (typeof values !== 'undefined' && values.property_type === 'cabin') ? 'selected' : '' %>>Cabin</option>
                <option value="campground" <%= (typeof values !== 'undefined' && values.property_type === 'campground') ? 'selected' : '' %>>Campground</option>
                <option value="rv_park" <%= (typeof values !== 'undefined' && values.property_type === 'rv_park') ? 'selected' : '' %>>RV Park</option>
                <option value="glamping" <%= (typeof values !== 'undefined' && values.property_type === 'glamping') ? 'selected' : '' %>>Glamping Site</option>
                <option value="lodge" <%= (typeof values !== 'undefined' && values.property_type === 'lodge') ? 'selected' : '' %>>Lodge / Resort</option>
                <option value="other" <%= (typeof values !== 'undefined' && values.property_type === 'other') ? 'selected' : '' %>>Other</option>
              </select>
            </div>
          </div>
          <div class="form-row form-row--two">
            <div class="form-group">
              <label for="location">Location <span class="required">*</span></label>
              <input type="text" id="location" name="location" required placeholder="Bull Shoals, AR"
                value="<%= typeof values !== 'undefined' && values.location ? values.location : '' %>">
            </div>
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="(870) 555-0142"
                value="<%= typeof values !== 'undefined' && values.phone ? values.phone : '' %>">
            </div>
          </div>
          <div class="form-group">
            <label for="message">Anything else you'd like us to know?</label>
            <textarea id="message" name="message" rows="3" placeholder="Number of units, amenities, nearby attractions, seasonal availability…"><%= (typeof values !== 'undefined' && values.message) ? values.message : '' %></textarea>
          </div>
          <div class="op-form__footer">
            <button type="submit" class="btn btn--primary btn--lg">Submit Property</button>
            <p class="op-form__note">No spam. We'll only contact you about your listing.</p>
          </div>
        </form>
      <% } %>
    </div>
  </section>

  <!-- Footer -->
  <%- include('partials/footer') %>
</body>
</html>
