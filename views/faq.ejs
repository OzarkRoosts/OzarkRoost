        <a href="/operators">For Operators</a>
      </div>
      <p class="site-footer__copy">&copy; 2026 OzarkRoost. Built by <a href="https://polsia.com" target="_blank" rel="noopener">Polsia</a>.</p>
    </div>
  </footer>

