<% const { adventures, categories } = require('../lib/adventure-directory'); const { getBundle } = require('../lib/affiliate-links'); const adventureBundle = getBundle('adventure'); const featured = adventures[0]; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>100 Ozark Adventures — OzarkRoost</title>
  <meta name="description" content="Find your next Ozark adventure: 100 real places across Arkansas and Missouri for floating, hiking, caves, fishing, wildlife, cycling, camping and scenic road trips.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,0..9,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    :root{--ink:#102317;--moss:#234b31;--gold:#d69a35;--cream:#f6f0e5;--muted:#667166;--line:#e7e3d9}*{box-sizing:border-box}.ad-page{background:#f8f6f0;color:var(--ink);min-height:100vh;font-family:'DM Sans',sans-serif}.wrap{max-width:1180px;margin:auto;position:relative;z-index:1}
    .hero{position:relative;overflow:hidden;background:radial-gradient(circle at 78% 15%,#5e8066 0,#193a26 38%,#091b10 100%);color:#fff;padding:28px 24px 72px}.hero:before,.hero:after{content:'';position:absolute;border-radius:50%;pointer-events:none}.hero:before{width:560px;height:560px;right:-220px;top:-290px;background:rgba(214,154,53,.16)}.hero:after{width:320px;height:320px;left:-220px;bottom:-220px;background:rgba(255,255,255,.05)}.nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:58px}.logo{font:400 25px 'DM Serif Display',serif;color:#fff;text-decoration:none}.navlinks a{color:rgba(255,255,255,.72);text-decoration:none;font-size:14px;margin-left:23px}.navlinks a:hover{color:#fff}.eyebrow{color:#f2c56c;text-transform:uppercase;letter-spacing:.2em;font-size:11px;font-weight:800}.hero h1{font:400 clamp(46px,8vw,92px)/.9 'DM Serif Display',serif;max-width:900px;margin:13px 0 20px}.hero h1 em{color:#f2c56c}.hero p{max-width:720px;color:rgba(255,255,255,.8);font-size:18px;line-height:1.65;margin:0}.searchbar{display:flex;gap:9px;flex-wrap:wrap;margin-top:28px}.searchbar input,.searchbar select{border:0;border-radius:999px;padding:15px 18px;font:500 14px 'DM Sans',sans-serif}.searchbar input{flex:1 1 320px;min-width:230px;outline:none}.searchbar select{background:#fff;color:var(--ink)}.chips{display:flex;gap:8px;overflow:auto;margin-top:16px;padding-bottom:4px}.chip{border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;border-radius:999px;padding:9px 13px;font-size:12px;white-space:nowrap;cursor:pointer}.chip.active,.chip:hover{background:#d69a35;border-color:#d69a35}.stats{display:flex;gap:10px;flex-wrap:wrap;margin-top:23px}.stat{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.12);padding:10px 14px;border-radius:999px;font-size:12px}.stat b{color:#f2c56c;margin-right:4px}
    main{max-width:1180px;margin:auto;padding:42px 24px 90px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin:0 0 18px}.section-head h2{font:400 35px/1.08 'DM Serif Display',serif;margin:0 0 6px}.section-head p{color:var(--muted);margin:0;line-height:1.55;font-size:14px}.count{font-size:12px;font-weight:800;color:var(--moss);white-space:nowrap}
    .feature{display:grid;grid-template-columns:1.35fr 1fr;gap:0;margin:0 0 46px;border-radius:24px;overflow:hidden;background:#173522;color:#fff;box-shadow:0 18px 50px rgba(16,35,23,.13)}.feature-art{min-height:290px;background:radial-gradient(circle at 70% 25%,#6d8b6e,#315c3e 45%,#112b1a);position:relative;padding:25px}.feature-art:after{content:'🌊';position:absolute;right:9%;bottom:8%;font-size:90px;filter:drop-shadow(0 8px 10px rgba(0,0,0,.18))}.feature-badge{display:inline-block;background:#d69a35;border-radius:999px;padding:7px 11px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em}.feature-copy{padding:32px}.feature-copy h2{font:400 39px/1.02 'DM Serif Display',serif;margin:12px 0 7px}.feature-copy .region{color:#f2c56c;font-size:12px;font-weight:700}.feature-copy p{color:rgba(255,255,255,.7);line-height:1.6;font-size:14px}.btn{display:inline-block;text-decoration:none;border-radius:999px;padding:12px 17px;background:#d69a35;color:#fff;font-weight:800;font-size:12px}.btn.alt{background:#edf0e9;color:var(--moss)}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card{background:#fff;border:1px solid var(--line);border-radius:19px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 5px 18px rgba(16,35,23,.05);transition:.2s}.card:hover{transform:translateY(-4px);box-shadow:0 15px 34px rgba(16,35,23,.11)}.card-top{height:105px;background:linear-gradient(135deg,#244d32,#47775a);position:relative}.card-top:after{content:'';position:absolute;inset:auto -20px -80px;height:140px;background:rgba(255,255,255,.08);border-radius:50%}.num{position:absolute;left:15px;top:13px;color:rgba(255,255,255,.72);font-size:11px;font-weight:800}.icon{position:absolute;right:15px;bottom:10px;font-size:28px}.body{padding:18px;display:flex;flex-direction:column;flex:1}.tag{text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:800;color:#a66b13;margin:0 0 7px}.card h3{font:400 22px/1.08 'DM Serif Display',serif;margin:0 0 6px}.region{font-size:11px;color:#788178;margin-bottom:9px}.desc{font-size:13px;line-height:1.55;color:#667166;margin:0 0 15px;flex:1}.actions{display:flex;gap:7px}.actions a{flex:1;text-align:center;padding:10px 9px;border-radius:10px;text-decoration:none;font-size:11px;font-weight:800}.explore{background:var(--moss);color:#fff}.claim{background:#f1eee6;color:var(--moss)}.note{font-size:10px;color:#8b928b;margin-top:10px}
    .weekend{margin:46px 0;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.week-card{padding:23px;border-radius:18px;background:#fff;border:1px solid var(--line)}.week-card strong{display:block;font:400 25px 'DM Serif Display',serif;margin-bottom:7px}.week-card span{display:block;color:var(--muted);font-size:12px;line-height:1.5;margin-bottom:15px}.week-card a{color:var(--moss);font-weight:800;text-decoration:none;font-size:12px}
    .promo{margin:48px 0 30px;background:linear-gradient(120deg,#173522,#315f40);border-radius:24px;padding:30px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:25px}.promo h2{font:400 32px/1.05 'DM Serif Display',serif;margin:0 0 7px}.promo p{max-width:650px;color:rgba(255,255,255,.7);line-height:1.55;font-size:13px;margin:0}.promo a{white-space:nowrap}.affiliate{padding:25px;border:1px solid var(--line);background:#fff;border-radius:19px}.affiliate h2{font:400 28px 'DM Serif Display',serif;margin:0 0 5px}.affiliate p{font-size:12px;color:var(--muted);margin:0 0 16px}.affgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.affgrid a{background:#f4f1e9;color:var(--ink);text-decoration:none;padding:12px;border-radius:10px;font-size:11px;font-weight:800}.empty{display:none;grid-column:1/-1;text-align:center;padding:55px;color:var(--muted)}
    @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}.feature{grid-template-columns:1fr}.weekend{grid-template-columns:1fr}.affgrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.navlinks{display:none}.hero{padding-bottom:48px}.hero p{font-size:16px}.searchbar{display:block}.searchbar input,.searchbar select{width:100%;margin-bottom:8px}.grid{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}.feature-copy{padding:25px}.feature-copy h2{font-size:34px}.promo{align-items:flex-start;flex-direction:column}.affgrid{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body><div class="ad-page">
<header class="hero"><div class="wrap">
  <nav class="nav"><a class="logo" href="/">OzarkRoost</a><div class="navlinks"><a href="/">Home</a><a href="/listings">Cabins</a><a href="/adventures">Adventures</a><a href="/list-your-cabin">List Free</a></div></nav>
  <div class="eyebrow">100 real places to go</div><h1>Your next Ozark adventure <em>starts here.</em></h1>
  <p>Pick a river. Chase a waterfall. Crawl into a cave. Find a trail that makes you forget your phone exists. We built a giant starter map of real places across the Arkansas and Missouri Ozarks.</p>
  <div class="searchbar"><input id="adSearch" type="search" placeholder="Search waterfall, cave, Buffalo, Missouri…" aria-label="Search adventures"><select id="adCategory" aria-label="Filter by activity"><option value="all">Every kind of adventure</option><% categories.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select></div>
  <div class="chips"><button class="chip active" data-adventure-filter="all">Everything</button><% categories.forEach(c => { %><button class="chip" data-adventure-filter="<%= c %>"><%= c %></button><% }) %></div>
  <div class="stats"><span class="stat"><b><%= adventures.length %></b> destinations</span><span class="stat"><b><%= categories.length %></b> ways to explore</span><span class="stat"><b>AR + MO</b> Ozarks</span><span class="stat">Founding listings are free</span></div>
</div></header>
<main>
  <section class="feature"><div class="feature-art"><span class="feature-badge">Adventure of the Week</span></div><div class="feature-copy"><div class="eyebrow">Start with a classic</div><h2><%= featured.name %></h2><div class="region"><%= featured.region %> · <%= featured.category %></div><p><%= featured.description %></p><a class="btn" data-adventure-share href="<%= featured.url %>" target="_blank" rel="noopener noreferrer">Explore the adventure →</a></div></section>
  <div class="section-head"><div><h2>Find Your Adventure</h2><p>Search the whole 100-place map, then pick the place that makes you want to leave today.</p></div><div class="count" id="adCount"><%= adventures.length %> showing</div></div>
  <section class="grid" id="adGrid" aria-live="polite">
    <% const icons = {Water:'🌊',Hiking:'🥾',Caves:'🪨',Fishing:'🎣',Scenic:'🌄',Wildlife:'🦌',Cycling:'🚵',Camping:'⛺',Family:'✨',History:'🏛️'}; adventures.forEach(a => { const outUrl = '/out?url=' + encodeURIComponent(a.url) + '&source=adventures&adventure=' + encodeURIComponent(a.id); %>
    <article class="card" data-search="<%= `${a.name} ${a.region} ${a.category} ${a.description}`.toLowerCase() %>" data-category="<%= a.category %>" data-adventure-url="<%= a.url %>"><div class="card-top"><span class="num">#<%= String(a.id).padStart(2,'0') %></span><span class="icon"><%= icons[a.category] || '🌲' %></span></div><div class="body"><p class="tag"><%= a.category %></p><h3><%= a.name %></h3><div class="region"><%= a.region %></div><p class="desc"><%= a.description %></p><div class="actions"><a class="explore" href="<%= outUrl %>" target="_blank" rel="noopener noreferrer">Explore →</a><a class="claim" href="/list-your-cabin">Claim / List</a></div><div class="note">Founding directory entry · unclaimed</div></div></article>
    <% }) %><div class="empty" id="adEmpty">Nothing matched. Try a town, river, waterfall, cave or activity.</div>
  </section>
  <section class="weekend"><div class="week-card"><strong>Make a Splash</strong><span>Rivers, lakes, floats and paddling when you need water under your feet.</span><a href="#adGrid" data-adventure-filter="Water">Find water →</a></div><div class="week-card"><strong>Go Wild</strong><span>Elk country, wildlife refuges, caves and trails for a proper Ozark reset.</span><a href="#adGrid" data-adventure-filter="Wildlife">Get wild →</a></div><div class="week-card"><strong>Take the Long Way</strong><span>Scenic roads, overlooks, historic places and stops worth making the drive for.</span><a href="#adGrid" data-adventure-filter="Scenic">Road-trip it →</a></div></section>
  <section class="promo"><div><h2>Own an Ozark adventure?</h2><p>Claim your place while we're building the region's biggest adventure guide. Founding partners can start with a free directory spot, then upgrade when they're ready for more visibility.</p></div><a class="btn" href="/list-your-cabin">Claim Your Free Spot →</a></section>
  <section class="affiliate"><h2>Build the trip around the adventure</h2><p>Useful booking and gear links live here so travelers can turn inspiration into a real trip. Affiliate availability depends on configured partners.</p><div class="affgrid"><% adventureBundle.forEach(link => { %><a href="<%= link.url %>" target="_blank" rel="sponsored noopener noreferrer"><%= link.label %> ↗</a><% }) %></div></section>
</main></div>
<script>
(()=>{const search=document.getElementById('adSearch'),select=document.getElementById('adCategory'),grid=document.getElementById('adGrid'),count=document.getElementById('adCount'),empty=document.getElementById('adEmpty'),cards=[...grid.querySelectorAll('.card')],chips=[...document.querySelectorAll('[data-adventure-filter]')];function apply(cat){select.value=cat;const q=(search.value||'').trim().toLowerCase();let n=0;cards.forEach(x=>{const ok=(!q||x.dataset.search.includes(q))&&(cat==='all'||x.dataset.category===cat);x.style.display=ok?'flex':'none';if(ok)n++});count.textContent=n+' showing';empty.style.display=n?'none':'block';chips.forEach(x=>x.classList.toggle('active',x.dataset.adventureFilter===cat))}search.addEventListener('input',()=>apply(select.value));select.addEventListener('change',()=>apply(select.value));chips.forEach(x=>x.addEventListener('click',e=>{e.preventDefault();apply(x.dataset.adventureFilter)}));})();
</script></body></html>
