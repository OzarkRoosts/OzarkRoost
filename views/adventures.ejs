  </div>
</nav>

<!-- Hero -->
<header class="adv-hero">
  <img
    src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/4e9d78f0-abc8-4aed-bb7e-a68d7f472d82.jpg"
