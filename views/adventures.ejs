<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Adventures in the Ozarks — OzarkRoost</title>
  <meta name="description" content="Explore the Arkansas Ozarks — kayaking, ATV trails, Jesse James history, missing gold legends, hot springs, and more. Curated adventures for every type of explorer.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    /* ===== Adventures Page ===== */
    .adv-hero {
      position: relative;
      height: clamp(480px, 60vh, 640px);
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      background: var(--pine-dark);
    }
    .adv-hero__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 40%;
      opacity: 0.6;
    }
    .adv-hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(14,34,18,0.85) 0%, rgba(14,34,18,0.3) 50%, transparent 80%);
    }
    .adv-hero__content {
      position: relative;
      z-index: 2;
      max-width: var(--max-w);
      width: 100%;
      margin: 0 auto;
      padding: 0 24px 56px;
    }
    .adv-hero__content .section-label { color: var(--amber-light); }
    .adv-hero__content h1 {
      font-family: var(--font-display);
      font-size: clamp(32px, 6vw, 60px);
      color: var(--cream);
      font-weight: 400;
      line-height: 1.05;
      margin-bottom: 16px;
    }
    .adv-hero__sub {
      font-size: 18px;
      color: rgba(245,240,232,0.75);
      max-width: 560px;
      line-height: 1.5;
    }

    /* Nav */
    .adv-nav {
      background: var(--pine-dark);
      border-bottom: 1px solid rgba(245,240,232,0.08);
    }
    .adv-nav__inner {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 24px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .adv-nav__logo {
      font-family: var(--font-display);
      font-size: 20px;
      color: var(--cream);
      text-decoration: none;
    }
    .adv-nav__links {
      display: flex;
      gap: 28px;
    }
    .adv-nav__links a {
      color: rgba(245,240,232,0.6);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: color 0.2s;
    }
    .adv-nav__links a:hover { color: var(--amber-light); }

    /* Intro */
    .adv-intro {
      padding: 64px 24px;
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
    }
    .adv-intro h2 {
      font-family: var(--font-display);
      font-size: clamp(26px, 4vw, 40px);
      color: var(--text-primary);
      margin-bottom: 16px;
      font-weight: 400;
    }
    .adv-intro p {
      font-size: 17px;
      color: var(--text-muted);
      line-height: 1.7;
    }

    /* Activity Grid */
    .adv-grid-section {
      padding: 0 24px 80px;
      max-width: var(--max-w);
      margin: 0 auto;
    }
    .adv-section-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--amber-dark);
      margin-bottom: 28px;
      padding-top: 16px;
    }
    .adv-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    /* Adventure Card */
    .adv-card {
      background: white;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(14,34,18,0.07);
      display: flex;
      flex-direction: column;
      transition: transform 0.25s, box-shadow 0.25s;
      cursor: default;
    }
    .adv-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(14,34,18,0.12);
    }
    .adv-card__img {
      position: relative;
      height: 160px;
      flex-shrink: 0;
      overflow: hidden;
    }
    .adv-card__img-bg {
      position: absolute;
      inset: 0;
      transition: transform 0.4s ease;
    }
    .adv-card:hover .adv-card__img-bg { transform: scale(1.04); }
    .adv-card__icon {
      position: absolute;
      bottom: 12px;
      left: 14px;
      width: 40px;
      height: 40px;
      background: rgba(245,240,232,0.95);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--pine);
    }
    .adv-card__body {
      padding: 18px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .adv-card__tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--amber-dark);
      margin-bottom: 6px;
    }
    .adv-card__name {
      font-family: var(--font-display);
      font-size: 18px;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-weight: 400;
      line-height: 1.2;
    }
    .adv-card__desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 14px;
      flex: 1;
    }
    .adv-card__stops {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-bottom: 16px;
    }
    .adv-card__stop {
      font-size: 11px;
      font-weight: 500;
      background: var(--cream-dark);
      color: var(--text-muted);
      padding: 3px 10px;
      border-radius: 50px;
    }
    .adv-card__link {
      display: inline-block;
      text-align: center;
      padding: 9px 16px;
      background: var(--pine);
      color: var(--cream);
      border-radius: var(--radius);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.2s;
    }
    .adv-card__link:hover { background: var(--pine-light); }
    .adv-card__link--outlined {
      background: transparent;
      border: 1.5px solid var(--pine-light);
      color: var(--pine);
    }
    .adv-card__link--outlined:hover {
      background: var(--pine);
      color: var(--cream);
    }
    .adv-card__link--amber {
      background: var(--amber);
      color: white;
    }
    .adv-card__link--amber:hover { background: var(--amber-dark); }

    /* Featured cards (Jesse James + Missing Gold — span 2 cols) */
    .adv-card--featured {
      grid-column: span 2;
      flex-direction: row;
    }
    .adv-card--featured .adv-card__img {
      height: auto;
      width: 42%;
      flex-shrink: 0;
    }
    .adv-card--featured .adv-card__body {
      padding: 28px;
      justify-content: center;
    }
    .adv-card--featured .adv-card__name { font-size: 26px; margin-bottom: 12px; }
    .adv-card--featured .adv-card__desc { font-size: 15px; margin-bottom: 18px; }

    /* CTA Section */
    .adv-cta {
      background: var(--pine);
      padding: 80px 24px;
      text-align: center;
    }
    .adv-cta__inner { max-width: 600px; margin: 0 auto; }
    .adv-cta__inner .section-label { color: var(--amber-light); margin-bottom: 14px; }
    .adv-cta__inner h2 {
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 46px);
      color: var(--cream);
      font-weight: 400;
      margin-bottom: 16px;
    }
    .adv-cta__inner p {
      font-size: 17px;
      color: rgba(245,240,232,0.65);
      margin-bottom: 36px;
      line-height: 1.6;
    }
    .adv-cta__actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .adv-cta__btn {
      display: inline-block;
      padding: 14px 32px;
      border-radius: 50px;
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
    }
    .adv-cta__btn--primary {
      background: var(--amber);
      color: white;
    }
    .adv-cta__btn--primary:hover { background: var(--amber-dark); transform: translateY(-1px); }
    .adv-cta__btn--ghost {
      background: rgba(245,240,232,0.1);
      color: var(--cream);
      border: 1.5px solid rgba(245,240,232,0.2);
    }
    .adv-cta__btn--ghost:hover {
      background: rgba(245,240,232,0.18);
      transform: translateY(-1px);
    }

    /* Responsive */
    @media (max-width: 900px) {
      .adv-grid { grid-template-columns: repeat(2, 1fr); }
      .adv-card--featured { grid-column: span 2; flex-direction: column; }
      .adv-card--featured .adv-card__img { height: 200px; width: 100%; }
    }
    @media (max-width: 640px) {
      .adv-grid { grid-template-columns: 1fr; }
      .adv-card--featured { grid-column: span 1; }
      .adv-card--featured .adv-card__img { height: 180px; }
      .adv-nav__links { display: none; }
      .adv-cta__actions { flex-direction: column; align-items: center; }
    }
  </style>
</head>
<body>

<!-- Nav -->
<nav class="adv-nav">
  <div class="adv-nav__inner">
    <a href="/" class="adv-nav__logo">OzarkRoost</a>
    <div class="adv-nav__links">
      <a href="/">Home</a>
