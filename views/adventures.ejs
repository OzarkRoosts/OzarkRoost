<!doctype html>
<% const { adventures, categories } = require('../lib/adventure-directory'); const { getBundle } = require('../lib/affiliate-links'); const adventureBundle = getBundle('adventure'); const featured = adventures.filter(a => a.featured).slice(0, 6); %>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>100 Ozark Adventures | OzarkRoost</title><meta name="description" content="Discover 100 real Ozark adventures across Arkansas and Missouri. Find rivers, waterfalls, caves, trails, wildlife, cycling, camping and scenic road trips."><link rel="stylesheet" href="/css/theme.css"><style>.p{min-height:100vh;background:#f8f6f0;color:#102317;font-family:system-ui,sans-serif}.hero{background:radial-gradient(circle at 80% 10%,#5d8065,#183a25 40%,#091b10);color:#fff;padding:28px 22px 72px}.w,main{max-width:1180px;margin:auto}.nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:58px}.logo{font:26px Georgia,serif;color:#fff;text-decoration:none}.nav a:not(.logo){color:#dce5dd;text-decoration:none;margin-left:20px;font-size:13px}.ey{color:#f2c66c;text-transform:uppercase;letter-spacing:.2em;font-size:11px;font-weight:900}.hero h1{font:400 clamp(48px,8vw,92px)/.9 Georgia,serif;max-width:900px;margin:12px 0 20px}.hero h1 em{color:#f2c66c}.hero p{max-width:730px;color:#dce5dd;font-size:18px;line-height:1.65}.search{display:flex;gap:9px;margin-top:27px;flex-wrap:wrap}.search input,.search select{border:0;border-radius:999px;padding:15px 18px;font-size:14px}.search input{flex:1 1 340px;min-width:230px}.chips{display:flex;gap:7px;overflow:auto;margin-top:14px}.chip{border:1px solid #ffffff30;background:#ffffff12;color:#fff;border-radius:999px;padding:9px 13px;white-space:nowrap;font-weight:700;font-size:11px;cursor:pointer}.chip.active,.chip:hover{background:#d59a35}.stats{display:flex;gap:9px;flex-wrap:wrap;margin-top:22px}.stat{background:#ffffff10;border:1px solid #ffffff18;padding:10px 13px;border-radius:999px;font-size:12px}.stat b{color:#f2c66c}.main{padding:45px 22px 90px}.head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:18px}.head h2{font:400 36px Georgia,serif;margin:0 0 5px}.head p{margin:0;color:#69736b;font-size:13px;line-height:1.55}.count{font-size:12px;font-weight:900;color:#214b31}.featured{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:48px}.fcard{min-height:205px;border-radius:21px;padding:22px;background:linear-gradient(145deg,#183b27,#4d765b);color:#fff;text-decoration:none;display:flex;flex-direction:column;justify-content:end}.fcard small{color:#f2c66c;text-transform:uppercase;letter-spacing:.12em;font-weight:900}.fcard h3{font:400 26px Georgia,serif;margin:7px 0}.fcard span{font-size:12px;color:#dce5dd}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:#fff;border:1px solid #e6e2d8;border-radius:19px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 5px 18px #1023170d}.top{height:103px;background:linear-gradient(135deg,#244d32,#5b8066);position:relative}.num{position:absolute;left:14px;top:12px;color:#ffffffb8;font-size:11px;font-weight:900}.ico{position:absolute;right:14px;bottom:10px;font-size:29px}.body{padding:18px;display:flex;flex-direction:column;flex:1}.tag{color:#a66b13;text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:900}.card h3{font:400 21px/1.08 Georgia,serif;margin:5px 0}.region{font-size:11px;color:#7b837c}.desc{font-size:13px;color:#667169;line-height:1.55;flex:1}.acts{display:flex;gap:7px}.acts a{flex:1;text-align:center;border-radius:10px;padding:10px 8px;text-decoration:none;font-size:11px;font-weight:900}.go{background:#214b31;color:#fff}.claim{background:#f1eee5;color:#214b31}.note{font-size:10px;color:#8a918b;margin-top:9px}.weekend{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:46px 0}.wk{background:#fff;border:1px solid #e6e2d8;border-radius:18px;padding:22px}.wk strong{display:block;font:400 25px Georgia,serif;margin-bottom:7px}.wk span{display:block;color:#69736b;font-size:12px;line-height:1.5;margin-bottom:14px}.wk a{color:#214b31;font-size:12px;font-weight:900;text-decoration:none}.promo{background:linear-gradient(120deg,#173522,#315f40);border-radius:24px;padding:30px;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:25px;margin:48px 0 28px}.promo h2{font:400 32px Georgia,serif;margin:0 0 7px}.promo p{max-width:680px;color:#d8e1da;line-height:1.55;font-size:13px;margin:0}.btn{display:inline-block;background:#d59a35;color:#fff;text-decoration:none;border-radius:999px;padding:13px 18px;font-weight:900;font-size:12px}.aff{background:#fff;border:1px solid #e6e2d8;border-radius:19px;padding:25px}.aff h2{font:400 28px Georgia,serif;margin:0 0 5px}.aff p{font-size:12px;color:#69736b}.affgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.affgrid a{background:#f4f1e9;color:#102317;text-decoration:none;padding:12px;border-radius:10px;font-size:11px;font-weight:800}.empty{display:none;grid-column:1/-1;text-align:center;padding:50px;color:#69736b}@media(max-width:900px){.grid,.featured{grid-template-columns:repeat(2,1fr)}.weekend{grid-template-columns:1fr}.promo{align-items:flex-start;flex-direction:column}.affgrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.navlinks{display:none}.hero{padding-bottom:50px}.hero p{font-size:16px}.search{display:block}.search input,.search select{width:100%;margin-bottom:8px}.grid,.featured{grid-template-columns:1fr}.head{align-items:flex-start;flex-direction:column}.affgrid{grid-template-columns:1fr 1fr}}</style></head><body><div class="p"><header class="hero"><div class="w"><nav class="nav"><a class="logo" href="/">OzarkRoost</a><div class="navlinks"><a href="/">Home</a><a href="/listings">Stays</a><a href="/adventures">Adventures</a><a href="/list-your-cabin">List Free</a></div></nav><div class="ey">Your next story starts here</div><h1>Find the wild side of <em>the Ozarks.</em></h1><p>One hundred real places to hike, float, climb, explore, camp, ride and disappear into the hills. Pick a vibe. Pick a direction. Go.</p><div class="search"><input id="adSearch" type="search" placeholder="Search waterfalls, caves, Buffalo, Bentonville…"><select id="adCategory"><option value="all">Every kind of adventure</option><% categories.forEach(c=>{ %><option value="<%= c %>"><%= c %></option><% }) %></select></div><div class="chips"><button class="chip active" data-adventure-filter="all">Everything</button><% categories.forEach(c=>{ %><button class="chip" data-adventure-filter="<%= c %>"><%= c %></button><% }) %></div><div class="stats"><span class="stat"><b><%= adventures.length %></b> destinations</span><span class="stat"><b><%= categories.length %></b> ways to explore</span><span class="stat"><b>AR + MO</b> Ozarks</span><span class="stat">Founding listings are free</span></div></div></header><main class="main"><section><div class="head"><div><h2>Adventure of the Week</h2><p>Six standout starting points for your next Ozark escape.</p></div></div><div class="featured"><% featured.forEach(a=>{ %><a class="fcard" href="/adventures/<%= a.slug %>"><small><%= a.category %> · <%= a.region %></small><h3><%= a.name %></h3><span>Open the OzarkRoost adventure guide →</span></a><% }) %></div></section><section><div class="head"><div><h2>Find Your Adventure</h2><p>Search all 100 places and start building a weekend.</p></div><div class="count" id="adCount"><%= adventures.length %> showing</div></div><div class="grid" id="adGrid"><% const icons={Water:'🌊',Hiking:'🥾',Caves:'🪨',Fishing:'🎣',Scenic:'🌄',Wildlife:'🦌',Cycling:'🚵',Camping:'⛺',Family:'✨',History:'🏛️'}; adventures.forEach(a=>{ %><article class="card" data-search="<%= `${a.name} ${a.region} ${a.category} ${a.description}`.toLowerCase() %>" data-category="<%= a.category %>"><div class="top"><span class="num">#<%= String(a.id).padStart(2,'0') %></span><span class="ico"><%= icons[a.category]||'🌲' %></span></div><div class="body"><span class="tag"><%= a.category %></span><h3><%= a.name %></h3><div class="region"><%= a.region %></div><p class="desc"><%= a.description %></p><div class="acts"><a class="go" href="/adventures/<%= a.slug %>">Explore guide →</a><a class="claim" href="/list-your-cabin">Claim / List</a></div><div class="note">Founding directory entry · unclaimed</div></div></article><% }) %><div class="empty" id="adEmpty">Nothing matched. Try a town, river, waterfall, cave or activity.</div></div></section><section class="weekend"><div class="wk"><strong>Make a Splash</strong><span>Rivers, lakes, floats and paddling for when you need water under your feet.</span><a href="#adGrid" data-adventure-filter="Water">Find water →</a></div><div class="wk"><strong>Go Wild</strong><span>Elk country, wildlife refuges, caves and trails for a proper Ozark reset.</span><a href="#adGrid" data-adventure-filter="Wildlife">Get wild →</a></div><div class="wk"><strong>Take the Long Way</strong><span>Scenic roads, overlooks and historic stops worth making the drive for.</span><a href="#adGrid" data-adventure-filter="Scenic">Road-trip it →</a></div></section><section class="promo"><div><h2>Own an Ozark adventure?</h2><p>Claim your founding directory spot while it is free. Add your official details, send travelers your way, and upgrade later for premium placement.</p></div><a class="btn" href="/list-your-cabin">Claim Your Free Spot →</a></section><section class="aff"><h2>Build the weekend</h2><p>Booking and gear links appear here when configured. Affiliate relationships are never implied where they do not exist.</p><div class="affgrid"><% adventureBundle.forEach(link=>{ %><a href="<%= link.url %>" target="_blank" rel="sponsored noopener noreferrer"><%= link.label %> ↗</a><% }) %></div></section></main></div><script>(()=>{const q=document.getElementById('adSearch'),cat=document.getElementById('adCategory'),cards=[...document.querySelectorAll('.card')],count=document.getElementById('adCount'),empty=document.getElementById('adEmpty'),buttons=[...document.querySelectorAll('[data-adventure-filter]')];let chosen='all';function filter(){const term=(q.value||'').toLowerCase().trim();let n=0;cards.forEach(c=>{const ok=(chosen==='all'||c.dataset.category===chosen)&&(!term||c.dataset.search.includes(term));c.style.display=ok?'flex':'none';if(ok)n++});count.textContent=n+' showing';empty.style.display=n?'none':'block'}buttons.forEach(b=>b.onclick=()=>{chosen=b.dataset.adventureFilter;cat.value=chosen;buttons.forEach(x=>x.classList.toggle('active',x.dataset.adventureFilter===chosen));filter()});cat.onchange=()=>{chosen=cat.value;buttons.forEach(x=>x.classList.toggle('active',x.dataset.adventureFilter===chosen));filter()};q.oninput=filter})();</script></body></html>