<% 
const adventureBundle = affiliateLinks || [];
const featured = adventures.filter(a => a.featured).slice(0, 6);
const photoBank = [
  { key: 'buffalo', url: 'https://www.nps.gov/common/uploads/structured_data/3C7AAF4E-1DD8-B71B-0B9952E34C998383.jpg?maxHeight=1200&maxWidth=1800&quality=88', alt: 'Kayakers floating on the Buffalo River near a limestone bluff', credit: 'NPS Photo', source: 'https://www.nps.gov/buff/' },
  { key: 'buffalo-cliffs', url: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Buffalo_National_River_BUFF0626.jpg', alt: 'Buffalo National River flowing below Ozark limestone bluffs', credit: 'National Park Service Digital Image Archives · Public Domain', source: 'https://commons.wikimedia.org/wiki/File:Buffalo_National_River_BUFF0626.jpg' },
  { key: 'hawksbill', url: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Hawksbill_Crag_-_Whitaker_Point_Trail_in_the_Upper_Buffalo_Wilderness%2C_Arkansas_%2847529284271%29.jpg', alt: 'Hawksbill Crag at Whitaker Point in the Upper Buffalo Wilderness', credit: 'Tony Webster · CC BY-SA 2.0', source: 'https://commons.wikimedia.org/wiki/File:Hawksbill_Crag_-_Whitaker_Point_Trail_in_the_Upper_Buffalo_Wilderness%2C_Arkansas_%2847529284271%29.jpg' },
  { key: 'cave', url: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Blanchard_Springs_Caverns.jpg', alt: 'Cave formations inside Blanchard Springs Caverns', credit: 'Chriseast18 · CC BY-SA 3.0', source: 'https://commons.wikimedia.org/wiki/File:Blanchard_Springs_Caverns.jpg' },
  { key: 'beaver', url: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Beaver_Lake_in_Arkansas.jpg', alt: 'Beaver Lake in the Arkansas Ozarks', credit: 'Michael Krewson · Public Domain', source: 'https://commons.wikimedia.org/wiki/File:Beaver_Lake_in_Arkansas.jpg' },
  { key: 'eureka', url: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Aerial_shot_of_downtown_Eureka_Springs%2C_Arkansas.jpg', alt: 'Aerial view of historic Eureka Springs surrounded by the Ozarks', credit: 'EurekaSpringsAR · CC BY-SA 4.0', source: 'https://commons.wikimedia.org/wiki/File:Aerial_shot_of_downtown_Eureka_Springs%2C_Arkansas.jpg' },
  { key: 'mountain-view', url: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Downtown_Mountain_View%2C_AR_024.jpg', alt: 'Historic downtown Mountain View, Arkansas', credit: 'Brandonrush · CC BY-SA 4.0', source: 'https://commons.wikimedia.org/wiki/File:Downtown_Mountain_View,_AR_024.jpg' },
  { key: 'ozark-trail', url: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Mark_Twain_NF_-_Marble_Creek_%2842776592955%29.jpg', alt: 'Marble Creek in Mark Twain National Forest along the Ozark Trail', credit: 'USFS Eastern Region · Public Domain', source: 'https://commons.wikimedia.org/wiki/File:Mark_Twain_NF_-_Marble_Creek_(42776592955).jpg' }
];
const photoFor = a => {
  const text = `${a.name} ${a.region} ${a.category}`.toLowerCase();
  if (/cave|cavern|underground|blanchard/.test(text)) return photoBank[3];
  if (/eureka/.test(text)) return photoBank[5];
  if (/beaver|lake|fishing|paddle|kayak|float|water/.test(text)) return /beaver|fishing|lake/.test(text) ? photoBank[4] : photoBank[0];
  if (/hawk|whitaker|crag|trail|hike|hiking|waterfall/.test(text)) return /hawk|whitaker|crag/.test(text) ? photoBank[2] : photoBank[1];
  if (/mountain view|folk|syllamo/.test(text)) return photoBank[6];
  if (/ozark trail|missouri|mark twain|camp|camping/.test(text)) return photoBank[7];
  if (/history|historic|scenic/.test(text)) return photoBank[5];
  return photoBank[1];
};
%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>100 Ozark Adventures | OzarkRoost</title>
<meta name="description" content="Discover 100 real Ozark adventures across Arkansas and Missouri with real destination photography, trails, rivers, caves, lakes, camping and scenic drives.">
<link rel="stylesheet" href="/css/theme.css">
<style>
:root{--ink:#102317;--green:#173b28;--green2:#285b3b;--gold:#e2ad48;--cream:#f7f4ec;--line:#e4dfd2}
*{box-sizing:border-box}.p{min-height:100vh;background:var(--cream);color:var(--ink);font-family:system-ui,sans-serif}.w,main{max-width:1240px;margin:auto}.hero{position:relative;isolation:isolate;overflow:hidden;min-height:720px;color:#fff;padding:26px 22px 90px;background:#102719}.hero-media{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;object-position:center 55%;filter:saturate(1.08)}.hero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(5,18,11,.94) 0%,rgba(9,28,17,.72) 42%,rgba(7,21,13,.28) 78%),linear-gradient(0deg,#173522 0,transparent 28%)}.nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:110px}.logo{font:700 28px Georgia,serif;color:#fff;text-decoration:none}.nav a:not(.logo){color:#e4ece5;text-decoration:none;margin-left:22px;font-size:13px;font-weight:700}.ey{color:#f4ca71;text-transform:uppercase;letter-spacing:.22em;font-size:11px;font-weight:900}.hero h1{font:400 clamp(50px,8vw,96px)/.88 Georgia,serif;max-width:920px;margin:14px 0 22px;letter-spacing:-.035em}.hero h1 em{color:#f4ca71}.hero p{max-width:730px;color:#e2ebe4;font-size:18px;line-height:1.65}.search{display:flex;gap:9px;margin-top:30px;flex-wrap:wrap}.search input,.search select{border:0;border-radius:999px;padding:15px 18px;font-size:14px;box-shadow:0 8px 30px #0002}.search input{flex:1 1 360px;min-width:230px}.chips{display:flex;gap:7px;overflow:auto;margin-top:14px;padding-bottom:3px}.chip{border:1px solid #ffffff30;background:#ffffff12;color:#fff;border-radius:999px;padding:9px 13px;white-space:nowrap;font-weight:800;font-size:11px;cursor:pointer}.chip.active,.chip:hover{background:#d59a35;border-color:#d59a35}.stats{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.stat{background:#071a0e88;border:1px solid #ffffff20;padding:10px 13px;border-radius:999px;font-size:12px;backdrop-filter:blur(8px)}.stat b{color:#f2c66c}.main{padding:55px 22px 100px}.head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:20px}.head h2{font:400 38px Georgia,serif;margin:0 0 5px}.head p{margin:0;color:#69736b;font-size:13px;line-height:1.55}.count{font-size:12px;font-weight:900;color:#214b31}.featured{display:grid;grid-template-columns:repeat(12,1fr);gap:15px;margin-bottom:56px}.fcard{position:relative;isolation:isolate;min-height:300px;border-radius:24px;overflow:hidden;color:#fff;text-decoration:none;display:flex;flex-direction:column;justify-content:end;padding:25px;background:#173b28}.fcard:nth-child(-n+2){grid-column:span 6;min-height:380px}.fcard:nth-child(n+3){grid-column:span 4;min-height:270px}.fcard img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .6s ease}.fcard:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,rgba(5,18,11,.9),rgba(5,18,11,.08) 65%)}.fcard:hover img{transform:scale(1.06)}.fcard small{color:#f4ca71;text-transform:uppercase;letter-spacing:.12em;font-weight:900}.fcard h3{font:400 clamp(25px,3vw,38px)/1.03 Georgia,serif;margin:8px 0}.fcard span{font-size:12px;color:#e0e9e2}.photo-credit{font-size:9px!important;line-height:1.3;color:#ffffffb8!important;margin-top:8px}.photo-credit a{color:inherit;text-decoration:underline}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card{background:#fff;border:1px solid var(--line);border-radius:21px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 8px 28px #1023170b;transition:transform .25s,box-shadow .25s}.card:hover{transform:translateY(-5px);box-shadow:0 18px 38px #10231718}.top{height:215px;background:#244d32;position:relative;overflow:hidden}.top img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}.card:hover .top img{transform:scale(1.05)}.top:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#081b0db0,transparent 65%)}.num{position:absolute;left:14px;top:12px;z-index:2;color:#fff;background:#0b2416b8;border:1px solid #ffffff25;border-radius:999px;padding:6px 9px;font-size:10px;font-weight:900;backdrop-filter:blur(6px)}.ico{position:absolute;right:14px;bottom:12px;z-index:2;font-size:25px;filter:drop-shadow(0 2px 4px #0008)}.body{padding:18px;display:flex;flex-direction:column;flex:1}.tag{color:#a66b13;text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:900}.card h3{font:400 22px/1.08 Georgia,serif;margin:6px 0}.region{font-size:11px;color:#7b837c}.desc{font-size:13px;color:#667169;line-height:1.55;flex:1}.acts{display:flex;gap:7px}.acts a{flex:1;text-align:center;border-radius:10px;padding:10px 8px;text-decoration:none;font-size:11px;font-weight:900}.go{background:#214b31;color:#fff}.claim{background:#f1eee5;color:#214b31}.note{font-size:10px;color:#8a918b;margin-top:9px}.weekend{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin:55px 0}.wk{position:relative;overflow:hidden;background:#173522;color:#fff;border-radius:20px;padding:25px;min-height:180px}.wk:after{content:"";position:absolute;right:-25px;bottom:-50px;width:180px;height:180px;border-radius:50%;background:url('https://commons.wikimedia.org/wiki/Special:Redirect/file/Buffalo_National_River_BUFF0626.jpg') center/cover;opacity:.25}.wk strong{display:block;position:relative;z-index:1;font:400 27px Georgia,serif;margin-bottom:7px}.wk span,.wk a{position:relative;z-index:1}.wk span{display:block;color:#d5dfd8;font-size:12px;line-height:1.5;margin-bottom:15px;max-width:330px}.wk a{color:#f4ca71;font-size:12px;font-weight:900;text-decoration:none}.promo{background:linear-gradient(120deg,#173522,#315f40);border-radius:25px;padding:31px;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:25px;margin:48px 0 30px}.promo h2{font:400 34px Georgia,serif;margin:0 0 7px}.promo p{max-width:680px;color:#d8e1da;line-height:1.55;font-size:13px;margin:0}.btn{display:inline-block;background:#d59a35;color:#fff;text-decoration:none;border-radius:999px;padding:14px 19px;font-weight:900;font-size:12px;white-space:nowrap}.aff{background:#fff;border:1px solid var(--line);border-radius:20px;padding:26px}.aff h2{font:400 28px Georgia,serif;margin:0 0 5px}.aff p{font-size:12px;color:#69736b}.affgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.affgrid a{background:#f4f1e9;color:#102317;text-decoration:none;padding:12px;border-radius:10px;font-size:11px;font-weight:800}.empty{display:none;grid-column:1/-1;text-align:center;padding:50px;color:#69736b}@media(max-width:900px){.nav{margin-bottom:75px}.featured{grid-template-columns:repeat(2,1fr)}.fcard,.fcard:nth-child(-n+2),.fcard:nth-child(n+3){grid-column:span 1;min-height:280px}.grid{grid-template-columns:repeat(2,1fr)}.weekend{grid-template-columns:1fr}.promo{align-items:flex-start;flex-direction:column}.affgrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.navlinks{display:none}.hero{min-height:760px;padding-bottom:50px}.hero p{font-size:16px}.search{display:block}.search input,.search select{width:100%;margin-bottom:8px}.featured,.grid{grid-template-columns:1fr}.fcard,.fcard:nth-child(-n+2),.fcard:nth-child(n+3){grid-column:1;min-height:310px}.top{height:205px}.head{align-items:flex-start;flex-direction:column}.affgrid{grid-template-columns:1fr 1fr}}
</style>
</head>
<body><div class="p">
<header class="hero">
  <img class="hero-media" src="<%= photoBank[0].url %>" alt="<%= photoBank[0].alt %>" fetchpriority="high">
  <div class="w"><nav class="nav"><a class="logo" href="/">OzarkRoost</a><div class="navlinks"><a href="/">Home</a><a href="/listings">Stays</a><a href="/adventures">Adventures</a><a href="/list-your-cabin">List Free</a></div></nav>
  <div class="ey">Your next story starts here</div><h1>Find the wild side of <em>the Ozarks.</em></h1>
  <p>One hundred real places to hike, float, climb, explore, camp, ride and disappear into the hills — now with real destination photography so you can see what is waiting before you go.</p>
  <div class="search"><input id="adSearch" type="search" placeholder="Search waterfalls, caves, Buffalo, Bentonville…"><select id="adCategory"><option value="all">Every kind of adventure</option><% categories.forEach(c=>{ %><option value="<%= c %>"><%= c %></option><% }) %></select></div>
  <div class="chips"><button class="chip active" data-adventure-filter="all">Everything</button><% categories.forEach(c=>{ %><button class="chip" data-adventure-filter="<%= c %>"><%= c %></button><% }) %></div>
  <div class="stats"><span class="stat"><b><%= adventures.length %></b> destinations</span><span class="stat"><b><%= categories.length %></b> ways to explore</span><span class="stat"><b>AR + MO</b> Ozarks</span><span class="stat">Founding listings are free</span></div>
  </div>
</header>
<main class="main">
<section><div class="head"><div><h2>Adventure of the Week</h2><p>Six standout starting points for your next Ozark escape.</p></div></div><div class="featured">
<% featured.forEach(a=>{ const photo=photoFor(a); %><a class="fcard" href="/adventures/<%= a.slug %>"><img loading="lazy" src="<%= photo.url %>" alt="<%= photo.alt %>"><small><%= a.category %> · <%= a.region %></small><h3><%= a.name %></h3><span>Open the OzarkRoost adventure guide →</span><span class="photo-credit">Photo: <a href="<%= photo.source %>" target="_blank" rel="noopener noreferrer"><%= photo.credit %></a></span></a><% }) %>
</div></section>
<section><div class="head"><div><h2>Find Your Adventure</h2><p>Search all 100 places and start building a weekend.</p></div><div class="count" id="adCount"><%= adventures.length %> showing</div></div>
<div class="grid" id="adGrid"><% const icons={Water:'🌊',Hiking:'🥾',Caves:'🪨',Fishing:'🎣',Scenic:'🌄',Wildlife:'🦌',Cycling:'🚵',Camping:'⛺',Family:'✨',History:'🏛️'}; adventures.forEach(a=>{ const photo=photoFor(a); %>
<article class="card" data-search="<%= `${a.name} ${a.region} ${a.category} ${a.description}`.toLowerCase() %>" data-category="<%= a.category %>"><div class="top"><img loading="lazy" src="<%= photo.url %>" alt="<%= photo.alt %>"><span class="num">#<%= String(a.id).padStart(2,'0') %></span><span class="ico"><%= icons[a.category]||'🌲' %></span></div><div class="body"><span class="tag"><%= a.category %></span><h3><%= a.name %></h3><div class="region"><%= a.region %></div><p class="desc"><%= a.description %></p><div class="acts"><a class="go" href="/adventures/<%= a.slug %>">Explore guide →</a><a class="claim" href="/list-your-cabin">Claim / List</a></div><div class="note">Founding directory entry · unclaimed</div><div class="photo-credit">Photo: <a href="<%= photo.source %>" target="_blank" rel="noopener noreferrer"><%= photo.credit %></a></div></div></article><% }) %><div class="empty" id="adEmpty">Nothing matched. Try a town, river, waterfall, cave or activity.</div></div></section>
<section class="weekend"><div class="wk"><strong>Make a Splash</strong><span>Rivers, lakes, floats and paddling for when you need water under your feet.</span><a href="#adGrid" data-adventure-filter="Water">Find water →</a></div><div class="wk"><strong>Go Wild</strong><span>Elk country, wildlife refuges, caves and trails for a proper Ozark reset.</span><a href="#adGrid" data-adventure-filter="Wildlife">Get wild →</a></div><div class="wk"><strong>Take the Long Way</strong><span>Scenic roads, overlooks and historic stops worth making the drive for.</span><a href="#adGrid" data-adventure-filter="Scenic">Road-trip it →</a></div></section>
<section class="promo"><div><h2>Own an Ozark adventure?</h2><p>Claim your founding directory spot while it is free. Add your official details, send travelers your way, and upgrade later for premium placement.</p></div><a class="btn" href="/list-your-cabin">Claim Your Free Spot →</a></section>
<section class="aff"><h2>Build the weekend</h2><p>Booking and gear links appear here when configured. Affiliate relationships are never implied where they do not exist.</p><div class="affgrid"><% adventureBundle.forEach(link=>{ %><a href="<%= link.url %>" target="_blank" rel="sponsored noopener noreferrer"><%= link.label %> ↗</a><% }) %></div></section>
</main></div>
<script>(()=>{const q=document.getElementById('adSearch'),cat=document.getElementById('adCategory'),cards=[...document.querySelectorAll('.card')],count=document.getElementById('adCount'),empty=document.getElementById('adEmpty'),buttons=[...document.querySelectorAll('[data-adventure-filter]')];let chosen='all';function filter(){const term=(q.value||'').toLowerCase().trim();let n=0;cards.forEach(c=>{const ok=(chosen==='all'||c.dataset.category===chosen)&&(!term||c.dataset.search.includes(term));c.style.display=ok?'flex':'none';if(ok)n++});count.textContent=n+' showing';empty.style.display=n?'none':'block'}buttons.forEach(b=>b.onclick=()=>{chosen=b.dataset.adventureFilter;cat.value=chosen;buttons.forEach(x=>x.classList.toggle('active',x.dataset.adventureFilter===chosen));filter()});cat.onchange=()=>{chosen=cat.value;buttons.forEach(x=>x.classList.toggle('active',x.dataset.adventureFilter===chosen));filter()};q.oninput=filter})();</script>
</body></html>
