<% const { adventures, categories } = require('../lib/adventures'); const { getBundle } = require('../lib/affiliate-links'); const adventureBundle = getBundle('adventure'); %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>100 Ozark Adventures — OzarkRoost</title>
  <meta name="description" content="Discover 100 real Ozark adventures across Arkansas and Missouri: rivers, caves, waterfalls, trails, wildlife, cycling, camping and unforgettable road trips.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,0..9,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    :root{--ad-ink:#102317;--ad-moss:#234b31;--ad-gold:#d69a35;--ad-cream:#f6f0e5;--ad-muted:#667166}
    *{box-sizing:border-box}.ad-page{background:#f8f6f0;color:var(--ad-ink);min-height:100vh}
    .ad-hero{position:relative;overflow:hidden;background:radial-gradient(circle at 80% 20%,#55745c 0,#193a26 38%,#0c2114 100%);color:white;padding:34px 24px 76px}.ad-hero:before{content:'';position:absolute;width:520px;height:520px;border-radius:50%;right:-160px;top:-230px;background:rgba(214,154,53,.18)}
    .ad-wrap{max-width:1180px;margin:auto;position:relative;z-index:1}.ad-nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:64px}.ad-logo{font:400 24px 'DM Serif Display',serif;color:white;text-decoration:none}.ad-nav a:not(.ad-logo){color:rgba(255,255,255,.72);text-decoration:none;font-size:14px;margin-left:24px}.ad-nav a:hover{color:#fff}
    .ad-kicker{color:#f2c56c;text-transform:uppercase;letter-spacing:.18em;font-weight:700;font-size:12px}.ad-hero h1{font:400 clamp(44px,8vw,88px)/.94 'DM Serif Display',serif;max-width:850px;margin:14px 0 20px}.ad-hero h1 em{color:#f2c56c}.ad-hero p{max-width:680px;font-size:19px;line-height:1.65;color:rgba(255,255,255,.78);margin:0}
    .ad-search{margin-top:32px;display:flex;gap:10px;flex-wrap:wrap}.ad-search input{flex:1 1 280px;min-width:240px;border:0;border-radius:999px;padding:15px 19px;font:500 15px 'DM Sans',sans-serif;outline:none}.ad-search select{border:0;border-radius:999px;padding:15px 18px;font:500 15px 'DM Sans',sans-serif;background:white;color:var(--ad-ink)}
    .ad-stats{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.ad-stat{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.13);padding:11px 15px;border-radius:999px;font-size:13px}.ad-stat b{color:#f2c56c;margin-right:4px}
    .ad-main{max-width:1180px;margin:auto;padding:52px 24px 90px}.ad-discovery{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:22px}.ad-discovery h2{font:400 38px/1.1 'DM Serif Display',serif;margin:0 0 8px}.ad-discovery p{margin:0;color:var(--ad-muted);line-height:1.6}.ad-count{font-size:13px;font-weight:700;color:var(--ad-moss);white-space:nowrap}
    .ad-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.ad-card{background:white;border:1px solid #e8e6dd;border-radius:20px;overflow:hidden;box-shadow:0 5px 20px rgba(16,35,23,.06);display:flex;flex-direction:column;transition:.2s}.ad-card:hover{transform:translateY(-5px);box-shadow:0 16px 36px rgba(16,35,23,.12)}
    .ad-card-top{height:122px;background:linear-gradient(135deg,#244d32,#47775a);position:relative;overflow:hidden}.ad-card-top:after{content:'';position:absolute;inset:auto -20px -75px -20px;height:140px;background:rgba(255,255,255,.08);border-radius:50%}.ad-num{position:absolute;left:16px;top:14px;color:rgba(255,255,255,.7);font-size:12px;font-weight:700}.ad-icon{position:absolute;right:15px;bottom:13px;font-size:28px}.ad-body{padding:19px;display:flex;flex-direction:column;flex:1}.ad-tag{font-size:10px;text-transform:uppercase;letter-spacing:.14em;font-weight:800;color:#a66b13;margin:0 0 7px}.ad-card h3{font:400 22px/1.08 'DM Serif Display',serif;margin:0 0 7px}.ad-region{font-size:12px;color:#788178;margin-bottom:10px}.ad-desc{font-size:13px;line-height:1.55;color:#667166;margin:0 0 16px;flex:1}.ad-actions{display:flex;gap:8px}.ad-link{flex:1;text-align:center;padding:10px 11px;border-radius:10px;background:var(--ad-moss);color:white;text-decoration:none;font-size:12px;font-weight:700}.ad-link.secondary{background:#f3f0e7;color:var(--ad-moss)}.ad-link:hover{filter:brightness(.94)}
    .ad-promo{margin:52px 0;background:linear-gradient(120deg,#183722,#2c5b3a);border-radius:26px;padding:32px;color:white;display:flex;justify-content:space-between;align-items:center;gap:30px}.ad-promo h2{font:400 31px/1.05 'DM Serif Display',serif;margin:0 0 8px}.ad-promo p{margin:0;color:rgba(255,255,255,.72);line-height:1.55;max-width:620px}.ad-promo a{background:#d69a35;color:white;text-decoration:none;font-weight:800;border-radius:999px;padding:14px 22px;white-space:nowrap}
    .ad-aff{margin:0 0 55px;padding:26px;background:#fff;border:1px solid #e6e2d7;border-radius:20px}.ad-aff h2{font:400 28px 'DM Serif Display',serif;margin:0 0 6px}.ad-aff p{margin:0 0 18px;color:var(--ad-muted);font-size:13px}.ad-aff-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.ad-aff a{background:#f5f2ea;border-radius:12px;padding:13px;text-decoration:none;color:var(--ad-ink);font-size:12px;font-weight:700}.ad-aff a:hover{background:#ebe6d9}
    .ad-empty{display:none;padding:50px;text-align:center;color:var(--ad-muted);grid-column:1/-1}.ad-note{font-size:11px;color:#8b928b;margin-top:14px}
    @media(max-width:900px){.ad-grid{grid-template-columns:repeat(2,1fr)}.ad-aff-grid{grid-template-columns:repeat(2,1fr)}.ad-promo{align-items:flex-start;flex-direction:column}.ad-discovery{align-items:flex-start;flex-direction:column}}
    @media(max-width:620px){.ad-nav a:not(.ad-logo){display:none}.ad-hero{padding-bottom:52px}.ad-grid{grid-template-columns:1fr}.ad-aff-grid{grid-template-columns:1fr 1fr}.ad-main{padding-top:36px}.ad-hero p{font-size:16px}.ad-search{display:block}.ad-search input,.ad-search select{width:100%;margin-bottom:8px}.ad-promo{padding:24px}}
  </style>
</head>
<body><div class="ad-page">
  <header class="ad-hero"><div class="ad-wrap">
    <nav class="ad-nav"><a class="ad-logo" href="/">OzarkRoost</a><div><a href="/">Home</a><a href="/listings">Cabins</a><a href="/adventures">Adventures</a><a href="/list-your-cabin">List Free</a></div></nav>
    <div class="ad-kicker">100 real places to go</div>
    <h1>Get outside. <em>Get Ozark.</em></h1>
    <p>Waterfalls. Wild rivers. Dark-sky nights. Cave country. Gravel roads. Big bluffs. We pulled together a giant starter map of places worth getting in the car for.</p>
    <div class="ad-search"><input id="adSearch" type="search" placeholder="Try “waterfall”, “cave”, “Buffalo”, “Missouri”…" aria-label="Search adventures"><select id="adCategory" aria-label="Filter by activity"><option value="all">All adventures</option><% categories.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select></div>
    <div class="ad-stats"><span class="ad-stat"><b><%= adventures.length %></b> destinations</span><span class="ad-stat"><b><%= categories.length %></b> ways to explore</span><span class="ad-stat"><b>AR + MO</b> Ozarks</span><span class="ad-stat">Founding listings are free</span></div>
  </div></header>
  <main class="ad-main">
    <div class="ad-discovery"><div><h2>Pick a direction. Then go.</h2><p>Every card is a real destination or operator. Business relationships are not implied unless a listing says so.</p></div><div class="ad-count" id="adCount"><%= adventures.length %> showing</div></div>
    <section class="ad-grid" id="adGrid" aria-live="polite">
      <% const icons = {Water:'🌊',Hiking:'🥾',Caves:'🪨',Fishing:'🎣',Scenic:'🌄',Wildlife:'🦌',Cycling:'🚵',Camping:'⛺',Family:'✨',History:'🏛️'}; adventures.forEach(a => { %>
      <article class="ad-card" data-search="<%= `${a.name} ${a.region} ${a.category} ${a.description}`.toLowerCase() %>" data-category="<%= a.category %>">
        <div class="ad-card-top"><span class="ad-num">#<%= String(a.id).padStart(2,'0') %></span><span class="ad-icon"><%= icons[a.category] || '🌲' %></span></div>
        <div class="ad-body"><p class="ad-tag"><%= a.category %></p><h3><%= a.name %></h3><div class="ad-region"><%= a.region %></div><p class="ad-desc"><%= a.description %></p><div class="ad-actions"><a class="ad-link" href="<%= a.url %>" target="_blank" rel="noopener noreferrer">Explore →</a><a class="ad-link secondary" href="/list-your-cabin">Claim / List</a></div><div class="ad-note">Founding directory entry · unclaimed</div></div>
      </article>
      <% }) %>
      <div class="ad-empty" id="adEmpty">No adventure matched that search. Try a town, river, cave, trail or activity.</div>
    </section>
    <section class="ad-promo"><div><h2>Own an Ozark adventure?</h2><p>Get in early. Founding partners can claim a free directory spot while OzarkRoost builds the region's adventure guide. Upgrade later for premium placement and promotion.</p></div><a href="/list-your-cabin">Claim Your Free Spot →</a></section>
    <section class="ad-aff"><h2>Build the trip around the adventure</h2><p>Helpful booking and gear links are surfaced for travelers. Affiliate availability depends on partner configuration; we never fake a commission.</p><div class="ad-aff-grid"><% adventureBundle.forEach(link => { %><a href="<%= link.url %>" target="_blank" rel="sponsored noopener noreferrer"><%= link.label %> ↗</a><% }) %></div></section>
  </main>
</div>
<script>
(() => {
  const search = document.getElementById('adSearch'), category = document.getElementById('adCategory'), grid = document.getElementById('adGrid'), count = document.getElementById('adCount'), empty = document.getElementById('adEmpty');
  const cards = [...grid.querySelectorAll('.ad-card')];
  function filter(){ const q=(search.value||'').trim().toLowerCase(), c=category.value; let visible=0; cards.forEach(card => { const ok=(!q||card.dataset.search.includes(q))&&(c==='all'||card.dataset.category===c); card.style.display=ok?'flex':'none'; if(ok) visible++; }); count.textContent=visible+' showing'; empty.style.display=visible?'none':'block'; }
  search.addEventListener('input',filter); category.addEventListener('change',filter);
})();
</script></body></html>
