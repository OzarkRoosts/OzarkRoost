<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore the Ozarks — Cabins, Camping, Fishing, Food & Adventures | OzarkRoost</title>
  <meta name="description" content="Explore the Arkansas Ozarks: cabins, vacation rentals, camping, RVs, fishing, restaurants, adventures, attractions, rentals and outdoor gear. Discover places to stay and things to do.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    .directory-hero{background:var(--pine);color:var(--cream);padding:72px 24px 64px;text-align:center}.directory-hero__inner{max-width:900px;margin:auto}.directory-hero h1{font-family:var(--font-display);font-size:clamp(38px,6vw,68px);font-weight:400;line-height:1.04;margin:10px 0 18px}.directory-hero p{max-width:680px;margin:auto;color:rgba(245,240,232,.72);font-size:18px;line-height:1.6}.directory-hero__chips{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:28px}.directory-hero__chip{padding:8px 14px;border:1px solid rgba(245,240,232,.2);border-radius:50px;color:var(--cream);text-decoration:none;font-size:13px}.directory-hero__chip:hover{background:rgba(245,240,232,.1)}
    .directory-section{max-width:1120px;margin:auto;padding:64px 24px}.directory-section--soft{max-width:none;background:var(--cream-dark)}.directory-section--soft>.directory-section__inner{max-width:1120px;margin:auto}.directory-heading{text-align:center;margin-bottom:34px}.directory-heading h2{font-family:var(--font-display);font-weight:400;font-size:clamp(28px,4vw,42px);margin:0 0 10px;color:var(--text-primary)}.directory-heading p{color:var(--text-muted);font-size:16px;max-width:700px;margin:auto;line-height:1.6}
    .category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.category-card{display:flex;flex-direction:column;min-height:190px;background:#fff;border:1px solid rgba(28,61,42,.08);border-radius:var(--radius-lg);padding:22px;text-decoration:none;box-shadow:0 2px 12px rgba(14,34,18,.05);transition:transform .2s,box-shadow .2s}.category-card:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(14,34,18,.1)}.category-card__icon{font-size:30px;margin-bottom:14px}.category-card h3{font-family:var(--font-display);font-size:21px;font-weight:400;color:var(--text-primary);margin:0 0 8px}.category-card p{font-size:13px;color:var(--text-muted);line-height:1.55;margin:0;flex:1}.category-card__cta{font-size:12px;font-weight:700;color:var(--amber-dark);margin-top:16px}
    .affiliate-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.affiliate-card{background:#fff;border-radius:var(--radius);padding:18px;text-decoration:none;border:1px solid rgba(28,61,42,.07)}.affiliate-card strong{display:block;color:var(--text-primary);font-size:14px;margin-bottom:6px}.affiliate-card span{display:block;color:var(--text-muted);font-size:12px;line-height:1.5}.affiliate-card__label{display:block;color:var(--amber-dark)!important;font-weight:700;margin-top:10px!important}
    .listing-shell{max-width:1120px;margin:auto;padding:0 24px 72px}.listing-shell__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.listing-shell__head h2{font-family:var(--font-display);font-weight:400;font-size:34px;margin:0}.listing-shell__head p{margin:5px 0 0;color:var(--text-muted);font-size:14px}.listing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.listing-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:0 2px 12px rgba(14,34,18,.07)}.listing-card__img{height:190px;background:linear-gradient(135deg,#1a4a3a,#2a6550,#1a3a2e);background-size:cover;background-position:center}.listing-card__body{padding:20px}.listing-card__location{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--amber-dark);font-weight:700}.listing-card__name{font-family:var(--font-display);font-size:22px;font-weight:400;margin:7px 0}.listing-card__desc{font-size:13px;color:var(--text-muted);line-height:1.55}.listing-card__links a{display:inline-block;margin-top:10px;color:var(--pine);font-weight:700;font-size:13px}
    .empty-listings{background:var(--cream-dark);border-radius:var(--radius-lg);padding:42px 24px;text-align:center}.empty-listings h3{font-family:var(--font-display);font-size:28px;font-weight:400;margin:0 0 8px}.empty-listings p{max-width:620px;margin:0 auto 22px;color:var(--text-muted);line-height:1.6}.button{display:inline-block;background:var(--amber);color:#fff;padding:12px 22px;border-radius:50px;text-decoration:none;font-weight:700;font-size:14px}.button:hover{background:var(--amber-dark)}
    @media(max-width:900px){.category-grid{grid-template-columns:repeat(2,1fr)}.affiliate-grid{grid-template-columns:repeat(2,1fr)}.listing-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.category-grid,.affiliate-grid,.listing-grid{grid-template-columns:1fr}.listing-shell__head{display:block}}
  </style>
</head>
<body>
<nav class="site-nav"><div class="site-nav__inner"><a href="/" class="site-nav__logo">OzarkRoost</a><div class="site-nav__links"><a href="/listings">Explore</a><a href="/adventures">Adventures</a><a href="/guides/ozarks-camping-rv">Camping</a><a href="/list-your-cabin" class="site-nav__cta">List Your Business</a></div></div></nav>
<header class="directory-hero"><div class="directory-hero__inner"><p class="section-label" style="color:var(--amber-light)">Arkansas Ozarks Directory</p><h1>Everything Ozarks. One Roost.</h1><p>Find where to stay, eat, fish, camp, explore, rent gear and build your next Ozarks adventure — then book directly through our travel partners.</p><div class="directory-hero__chips"><a class="directory-hero__chip" href="/adventures">🛶 Adventures</a><a class="directory-hero__chip" href="/guides/ozarks-camping-rv">⛺ Camping & RV</a><a class="directory-hero__chip" href="/guides/ozarks-adventures">🎣 Fishing</a><a class="directory-hero__chip" href="/guides/about-the-ozarks">🍽️ Food & Towns</a><a class="directory-hero__chip" href="/guides/ozarks-road-trip">🚙 Road Trips</a></div></div></header>

<section class="directory-section"><div class="directory-heading"><h2>Explore by what you want to do</h2><p>The directory is built around the way people actually plan Ozarks trips — stay somewhere, do something, eat somewhere good, and get the gear to make it happen.</p></div><div class="category-grid"><% (directoryCategories || []).forEach(function(category){ %><a class="category-card" href="<%= category.href %>"><div class="category-card__icon"><%= category.icon %></div><h3><%= category.label %></h3><p><%= category.description %></p><span class="category-card__cta">Explore →</span></a><% }); %></div></section>

<section class="directory-section directory-section--soft"><div class="directory-section__inner"><div class="directory-heading"><h2>Book, reserve & gear up</h2><p>Affiliate links are built into the travel experience so visitors can go from inspiration to action without leaving the trip-planning flow.</p></div><div class="affiliate-grid"><% const groups = [['stays','Where to Stay'],['camping','Camp & RV'],['adventure','Do More'],['gear','Gear Up']]; groups.forEach(function(group){ (affiliateBundles && affiliateBundles[group[0]] || []).forEach(function(widget){ %><a class="affiliate-card" href="/out?to=<%= encodeURIComponent(widget.url) %>&partner=<%= encodeURIComponent(widget.key) %>" target="_blank" rel="noopener noreferrer sponsored"><strong><%= widget.label %></strong><span><%= widget.blurb %></span><span class="affiliate-card__label"><%= group[1] %> →</span></a><% }); }); %></div></div></section>

<section class="listing-shell"><div class="listing-shell__head"><div><h2>Featured OzarkRoost businesses</h2><p>Paid customer listings appear here after their listing is activated.</p></div><a class="button" href="/operators">Get the $49 listing</a></div>
<% if (listings && listings.length) { %><div class="listing-grid"><% listings.forEach(function(listing){ %><article class="listing-card"><div class="listing-card__img" <% if(listing.photo_url){ %>style="background-image:url('<%= listing.photo_url %>')"<% } %>></div><div class="listing-card__body"><div class="listing-card__location"><%= listing.location || 'Ozarks' %></div><h3 class="listing-card__name"><%= listing.property_name %></h3><p class="listing-card__desc"><%= listing.description || '' %></p><% if(listing.website_url){ %><a href="/out?listing=<%= listing.id %>&partner=direct" target="_blank" rel="noopener">Visit business →</a><% } %></div></article><% }); %></div><% } else { %><div class="empty-listings"><h3>We're filling the Roost now.</h3><p>OzarkRoost is opening paid placements for cabins, vacation rentals, campgrounds, RV parks, restaurants, outfitters, fishing guides, attractions, rentals and other Ozarks businesses. The first tier is <strong>$49/month</strong>.</p><a class="button" href="/operators">Claim a $49 spot →</a></div><% } %></section>

<%- include('partials/footer') %>
</body>
</html>
