<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore the Ozarks — Cabins, Camping, Fishing, Food & Adventures | OzarkRoost</title>
  <meta name="description" content="Explore the Arkansas Ozarks: cabins, vacation rentals, camping, RVs, fishing, restaurants, adventures, attractions, rentals and outdoor gear. Discover places to stay and things to do.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    :root{--market-ink:#13271c;--market-muted:#657168;--market-paper:#fbf8f2;--market-soft:#f0eadf;--market-line:rgba(19,39,28,.11)}
    body{background:var(--market-paper)}
    .market-hero{position:relative;min-height:570px;display:flex;align-items:flex-end;overflow:hidden;background:#173b2b;color:#fff}
    .market-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%;filter:saturate(1.04)}
    .market-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,24,14,.08) 15%,rgba(8,24,14,.25) 40%,rgba(7,19,12,.91) 100%)}
    .market-hero__content{position:relative;z-index:2;width:min(1120px,100%);margin:0 auto;padding:90px 24px 54px}
    .market-kicker{margin:0 0 12px;color:#f4c36b;font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}
    .market-hero h1{max-width:850px;font-family:var(--font-display);font-weight:400;font-size:clamp(48px,8vw,88px);line-height:.98;margin:0 0 18px;letter-spacing:-.02em}
    .market-hero p{max-width:650px;margin:0;color:rgba(255,255,255,.8);font-size:17px;line-height:1.65}
    .market-search{display:flex;gap:10px;max-width:760px;margin-top:28px;padding:9px;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.22);border-radius:18px;backdrop-filter:blur(14px)}
    .market-search a{flex:1;min-width:0;padding:14px 16px;background:#fff;color:var(--market-ink);border-radius:11px;text-decoration:none;font-size:14px;font-weight:700}.market-search a span{display:block;color:#78837c;font-size:11px;font-weight:500;margin-top:3px}
    .market-search .market-search__cta{flex:0 0 auto;background:var(--amber);color:#fff;padding-inline:22px;display:flex;align-items:center}
    .market-main{max-width:1200px;margin:auto;padding:72px 24px 90px}
    .market-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:28px}.market-heading h2{font-family:var(--font-display);font-size:clamp(34px,5vw,58px);font-weight:400;line-height:1;margin:0;color:var(--market-ink)}.market-heading p{max-width:430px;margin:0;color:var(--market-muted);line-height:1.65;font-size:14px}
    .visual-filters{display:flex;gap:9px;overflow-x:auto;padding:3px 0 20px;scrollbar-width:none}.visual-filters::-webkit-scrollbar{display:none}.visual-filters a{white-space:nowrap;border:1px solid var(--market-line);border-radius:99px;padding:9px 14px;color:var(--market-ink);background:#fff;text-decoration:none;font-size:12px;font-weight:700}.visual-filters a:hover{background:var(--market-soft)}
    .feature-grid{display:grid;grid-template-columns:1.55fr .8fr .8fr;grid-template-rows:230px 230px;gap:13px;margin-bottom:78px}
    .feature-tile{position:relative;overflow:hidden;border-radius:17px;display:flex;align-items:flex-end;min-height:190px;color:#fff;text-decoration:none;background:#214b39;isolation:isolate}.feature-tile:first-child{grid-row:1 / 3}.feature-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .65s ease}.feature-tile:hover img{transform:scale(1.055)}.feature-tile:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 22%,rgba(7,20,12,.86) 100%);z-index:1}.feature-tile__copy{position:relative;z-index:2;padding:22px;width:100%}.feature-tile__copy small{display:block;color:#f4c36b;text-transform:uppercase;letter-spacing:.13em;font-size:9px;font-weight:800;margin-bottom:7px}.feature-tile__copy strong{display:block;font-family:var(--font-display);font-size:clamp(23px,3vw,36px);font-weight:400;line-height:1.04}.feature-tile:not(:first-child) .feature-tile__copy strong{font-size:24px}.feature-tile__copy span{display:block;margin-top:5px;color:rgba(255,255,255,.73);font-size:11px}
    .listing-section{padding-top:4px}.listing-section__top{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.listing-section__top h2{font-family:var(--font-display);font-size:clamp(32px,4vw,48px);font-weight:400;color:var(--market-ink);margin:0}.listing-section__top p{color:var(--market-muted);font-size:13px;margin:6px 0 0}.button{display:inline-block;background:var(--amber);color:#fff;padding:12px 20px;border-radius:99px;text-decoration:none;font-weight:800;font-size:13px;white-space:nowrap}.button:hover{background:var(--amber-dark)}
    .listing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.listing-card{background:#fff;border:1px solid var(--market-line);border-radius:17px;overflow:hidden;box-shadow:0 8px 28px rgba(14,34,18,.055);transition:transform .22s ease,box-shadow .22s ease}.listing-card:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(14,34,18,.11)}
    .listing-card__img{position:relative;height:235px;background-size:cover;background-position:center;overflow:hidden}.listing-card__img:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.03),rgba(0,0,0,.36));pointer-events:none}.listing-card__img--fallback{background-image:url('https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/45feb759-0cd4-4ec0-91d2-1b88d27586d9.jpg')}
    .listing-card__tag{position:absolute;left:14px;top:14px;z-index:2;padding:6px 9px;border-radius:99px;background:rgba(255,255,255,.91);color:var(--market-ink);font-size:9px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.listing-card__save{position:absolute;right:14px;top:13px;z-index:2;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.9);color:var(--market-ink);font-size:16px}
    .listing-card__body{padding:19px 19px 20px}.listing-card__location{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--amber-dark);font-weight:800}.listing-card__name{font-family:var(--font-display);font-size:25px;font-weight:400;color:var(--market-ink);line-height:1.06;margin:7px 0 9px}.listing-card__desc{font-size:13px;color:var(--market-muted);line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:60px}.listing-card__footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:15px;padding-top:14px;border-top:1px solid var(--market-line)}.listing-card__footer a{color:var(--market-ink);font-size:12px;font-weight:800;text-decoration:none}.listing-card__footer .claim-link{color:var(--amber-dark)}
    .empty-listings{position:relative;overflow:hidden;border-radius:19px;background:#173b2b;color:#fff;padding:65px 30px;text-align:center}.empty-listings:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(12,42,27,.86),rgba(12,42,27,.62)),url('https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/2519cf24-2238-4de2-b2cd-9f03c7708da7.jpg') center/cover}.empty-listings>*{position:relative;z-index:1}.empty-listings h3{font-family:var(--font-display);font-size:39px;font-weight:400;margin:0 0 10px}.empty-listings p{max-width:620px;margin:0 auto 23px;color:rgba(255,255,255,.76);line-height:1.65;font-size:14px}
    .market-cta{margin-top:76px;border-radius:20px;background:var(--market-soft);padding:42px 36px;display:flex;align-items:center;justify-content:space-between;gap:30px}.market-cta h3{font-family:var(--font-display);font-size:34px;font-weight:400;color:var(--market-ink);margin:0 0 6px}.market-cta p{color:var(--market-muted);margin:0;font-size:13px;line-height:1.6}
    @media(max-width:900px){.feature-grid{grid-template-columns:1fr 1fr;grid-template-rows:300px 210px}.feature-tile:first-child{grid-column:1 / 3;grid-row:auto}.listing-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:620px){.market-hero{min-height:650px}.market-hero__content{padding:80px 16px 30px}.market-hero h1{font-size:50px}.market-search{display:block;padding:7px}.market-search a{display:block;margin-bottom:7px}.market-search .market-search__cta{display:flex;justify-content:center;margin:0}.market-main{padding:55px 16px 65px}.market-heading,.listing-section__top,.market-cta{display:block}.market-heading p{margin-top:16px}.feature-grid{display:flex;flex-direction:column;gap:11px}.feature-tile,.feature-tile:first-child{min-height:280px}.listing-grid{grid-template-columns:1fr}.listing-card__img{height:245px}.market-cta{padding:30px 24px}.market-cta .button{margin-top:18px}}
    @media(prefers-reduced-motion:reduce){.feature-tile img,.listing-card{transition:none}}
  </style>
</head>
<body>
<nav class="site-nav"><div class="site-nav__inner"><a href="/" class="site-nav__logo">OzarkRoost</a><div class="site-nav__links"><a href="/listings">Explore</a><a href="/adventures">Adventures</a><a href="/guides/ozarks-camping-rv">Camping</a><a href="/list-your-cabin" class="site-nav__cta">List Your Business</a></div></div></nav>

<header class="market-hero">
  <img class="market-hero__image" src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/1da12ea6-9762-4418-aec4-f0db946b2776.jpg" alt="Ozark wilderness and cabin country" fetchpriority="high">
  <div class="market-hero__content">
    <p class="market-kicker">The Ozarks, better explored</p>
    <h1>Find the place you'll want to remember.</h1>
    <p>Cabins, campsites, lake stays, local businesses and wild weekends — discover the Ozarks through places worth the drive.</p>
    <div class="market-search" aria-label="Explore Ozarks categories">
      <a href="/guides/buffalo-river-cabins">Where are you staying?<span>Cabins · rentals · camping</span></a>
      <a href="/adventures">What are you doing?<span>Rivers · trails · waterfalls</span></a>
      <a class="market-search__cta" href="/plan.html">Build my trip →</a>
    </div>
  </div>
</header>

<main class="market-main">
  <div class="market-heading">
    <div><p class="market-kicker">Start with the good stuff</p><h2>Explore the Ozarks.</h2></div>
    <p>Skip the generic search results. Start with hand-picked trip ideas, then drill into stays, adventures and local businesses.</p>
  </div>

  <nav class="visual-filters" aria-label="Explore categories">
    <a href="/guides/buffalo-river-cabins">🏡 Cabins & stays</a>
    <a href="/guides/hidden-gem-cabins">🌲 Hidden gems</a>
    <a href="/guides/ozarks-waterfalls">💧 Waterfalls</a>
    <a href="/guides/buffalo-river-kayaking">🛶 Floating</a>
    <a href="/guides/ozarks-camping-rv">⛺ Camping & RV</a>
    <a href="/guides/ozarks-adventures">🥾 Adventures</a>
    <a href="/guides/best-lakes-in-the-ozarks">🎣 Lakes & fishing</a>
    <a href="/guides/best-things-to-do-eureka-springs">✨ Eureka Springs</a>
  </nav>

  <section class="feature-grid" aria-label="Featured Ozarks experiences">
    <a class="feature-tile" href="/guides/buffalo-river-cabins"><img src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/1da12ea6-9762-4418-aec4-f0db946b2776.jpg" alt="Buffalo River cabin country" loading="lazy"><span class="feature-tile__copy"><small>01 · Stay</small><strong>Buffalo River Country</strong><span>River mornings, bluff views and porch nights.</span></span></a>
    <a class="feature-tile" href="/guides/hidden-gem-cabins"><img src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/45feb759-0cd4-4ec0-91d2-1b88d27586d9.jpg" alt="Secluded Ozark cabin" loading="lazy"><span class="feature-tile__copy"><small>02 · Escape</small><strong>Hidden Gem Cabins</strong><span>Get away from everything.</span></span></a>
    <a class="feature-tile" href="/guides/luxury-cabins"><img src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/2519cf24-2238-4de2-b2cd-9f03c7708da7.jpg" alt="Elevated Ozark cabin retreat" loading="lazy"><span class="feature-tile__copy"><small>03 · Indulge</small><strong>Cabins, Elevated</strong><span>Hot tubs, views and wow.</span></span></a>
    <a class="feature-tile" href="/guides/buffalo-river-kayaking"><img src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/3e9d12aa-48b6-4507-a983-bd992c68e524.jpg" alt="Kayaking the Buffalo River" loading="lazy"><span class="feature-tile__copy"><small>04 · Adventure</small><strong>Float the Buffalo</strong><span>Clear water. Big bluffs. No boring weekends.</span></span></a>
    <a class="feature-tile" href="/guides/ozarks-camping-rv"><img src="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_197924/a7e643a3-79e4-4a6c-819b-eef5f1824545.jpg" alt="Ozarks camping and RV escape" loading="lazy"><span class="feature-tile__copy"><small>05 · Outside</small><strong>Sleep Under Stars</strong><span>Camp, RV and stay wild.</span></span></a>
  </section>

  <section class="listing-section" aria-labelledby="listing-title">
    <div class="listing-section__top"><div><h2 id="listing-title">Places worth booking.</h2><p>Real Ozarks businesses are being added every week.</p></div><a class="button" href="/list-your-cabin">Claim a free spot →</a></div>
    <% if (listings && listings.length) { %>
      <div class="listing-grid">
      <% listings.forEach(function(listing){ %>
        <article class="listing-card">
          <div class="listing-card__img <%= listing.photo_url ? '' : 'listing-card__img--fallback' %>" <% if(listing.photo_url){ %>style="background-image:url('<%= listing.photo_url %>')"<% } %>>
            <span class="listing-card__tag"><%= listing.payment_status === 'free' ? 'Founding free listing' : 'Featured stay' %></span>
            <span class="listing-card__save" aria-hidden="true">♡</span>
          </div>
          <div class="listing-card__body">
            <div class="listing-card__location"><%= listing.location || 'Ozarks, Arkansas' %></div>
            <h3 class="listing-card__name"><%= listing.property_name %></h3>
            <p class="listing-card__desc"><%= listing.description || 'A place to stay, explore and make the most of your Ozarks trip.' %></p>
            <div class="listing-card__footer">
              <% if(listing.website_url){ %><a href="/out?listing=<%= listing.id %>&partner=direct" target="_blank" rel="noopener sponsored">Visit business ↗</a><% } else { %><span></span><% } %>
              <a class="claim-link" href="/list-your-cabin">Claim / update →</a>
            </div>
          </div>
        </article>
      <% }); %>
      </div>
    <% } else { %>
      <div class="empty-listings"><h3>We're filling the Roost.</h3><p>We're inviting real Ozarks destinations to claim a limited-time free founding listing. Be one of the first places travelers discover here.</p><a class="button" href="/list-your-cabin">Claim your free spot →</a></div>
    <% } %>
  </section>

  <section class="market-cta"><div><h3>Own an Ozarks business?</h3><p>Get your place in front of travelers while the founding directory is still free.</p></div><a class="button" href="/list-your-cabin">List your business →</a></section>
</main>

<%- include('partials/footer') %>
</body>
</html>