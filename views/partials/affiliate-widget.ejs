<%
  // affiliate-widget.ejs
  // Renders intent-matched monetization CTAs through the tracked /out gateway.
  const bundleMap = {
    stays: ['stay22','travelpayouts','hipcamp','vrbo','booking','airbnb','expedia','hotels','kayak'],
    luxury: ['stay22','travelpayouts','vrbo','booking','expedia','hotels'],
    camping: ['hipcamp','koa','outdoorsy','rvshare','recreation','rei','publiclands','cabela','amazon_camping'],
    adventure: ['getyourguide','viator','alltrails','klook','travelpayouts','amazon_kayak'],
    roadtrip: ['travelpayouts','stay22','kayak','expedia','hotels','tripadvisor','alltrails','outdoorsy'],
    gear: ['rei','publiclands','cabela','amazon_camping','amazon_binoculars'],
    parks: ['travelpayouts','recreation','alltrails','nationalparktrips','hipcamp'],
    monetize_all: ['stay22','travelpayouts','hipcamp','vrbo','booking','airbnb','expedia','hotels','kayak','getyourguide','viator','klook','outdoorsy','rvshare','recreation','koa','rei','publiclands','alltrails','tripadvisor','cabela','nationalparktrips','amazon_camping','amazon_kayak','amazon_binoculars']
  };
  let keys = typeof widgets !== 'undefined' ? widgets : (typeof widget !== 'undefined' ? [widget] : []);
  if (typeof bundle !== 'undefined' && bundleMap[bundle]) keys = bundleMap[bundle];
  const aff = typeof affiliateLinks !== 'undefined' ? affiliateLinks : {};
  const labels = {
    stay22:'Find cabins on Stay22 map', travelpayouts:'Compare travel deals', hipcamp:'Browse Hipcamp stays', rei:'Gear up at REI', getyourguide:'Book tours on GetYourGuide', viator:'Book experiences on Viator',
    outdoorsy:'Rent an RV on Outdoorsy', rvshare:'Find RVs on RVshare', vrbo:'Browse Vrbo cabins', booking:'Search Booking.com', publiclands:'Outfit at Public Lands', expedia:'Compare hotels on Expedia',
    hotels:'Search Hotels.com', kayak:'Compare travel prices on Kayak', tripadvisor:'Read reviews on Tripadvisor', klook:'Browse activities on Klook', alltrails:'Map trails on AllTrails', airbnb:'Browse Airbnb Ozarks homes',
    recreation:'Reserve on Recreation.gov', koa:'Find KOA campgrounds', cabela:'Shop camping gear at Cabela’s', nationalparktrips:'Explore national park trips', amazon_camping:'Camping essentials on Amazon',
    amazon_kayak:'Kayaks & paddles on Amazon', amazon_binoculars:'Travel binoculars on Amazon', list_cabin:'List your cabin on OzarkRoost', operators:'Partner with OzarkRoost'
  };
  const blurbs = {
    stay22:'Compare bookable stays near your Ozarks route.', travelpayouts:'Travel-search options for lodging and trip planning.', hipcamp:'Unique land stays, glamping sites, and private campgrounds.', rei:'Camping, hiking, fishing, and river gear.', getyourguide:'Book guided tours and activities for your trip.', viator:'Search experiences, tours, and tickets for your itinerary.',
    outdoorsy:'RV and camper rentals for Arkansas road trips.', rvshare:'Peer-to-peer RV rentals near the Ozarks.', vrbo:'Whole-home cabin rentals and vacation homes.', booking:'Search lodging inventory across Arkansas.', publiclands:'Camping and trail gear for public-land weekends.', expedia:'Compare hotels and stays when you need options.',
    hotels:'Find lodging near lakes, towns, and attractions.', kayak:'Compare travel prices in one search.', tripadvisor:'Traveler reviews and photos before you book.', klook:'Tickets and activities for your itinerary.', alltrails:'Trail maps for Ozarks hikes and adventures.', airbnb:'Unique homes and host-run stays.',
    recreation:'Official camping and recreation reservations.', koa:'Campground options for road trips.', cabela:'Outdoor gear for camping, fishing, and road trips.', nationalparktrips:'Trip inspiration for public lands and national park adventures.', amazon_camping:'Camp kitchen, lights, and packing-list staples.',
    amazon_kayak:'Portable boats and paddling gear.', amazon_binoculars:'Compact glass for wildlife and overlooks.', list_cabin:'Get discovered by travelers planning Ozarks trips.', operators:'Put your tourism business in front of Ozarks travelers.'
  };
%>
<% if (keys.length) { %>
<div class="aff-widgets" data-affiliate-bundle="<%= typeof bundle !== 'undefined' ? bundle : 'custom' %>">
  <% keys.forEach(function(key) {
    const k = typeof key === 'string' ? key.toLowerCase() : String(key.key || '').toLowerCase();
    const url = aff[k] || (key && key.url);
    const label = (key && typeof key === 'object' && key.label) || labels[k] || k;
    const blurb = (key && typeof key === 'object' && key.blurb) || blurbs[k] || '';
    if (!url) return;
  %>
  <aside class="aff-widget aff-widget--<%= k %>">
    <p class="aff-widget__label"><%= label %></p>
    <p class="aff-widget__blurb"><%= blurb %></p>
    <a href="/out?to=<%= encodeURIComponent(url) %>" rel="noopener noreferrer sponsored" class="aff-widget__btn aff-widget__btn--<%= k %>"><%= label %> →</a>
  </aside>
  <% }) %>
</div>
<% } %>
