<section class="newsletter-signup" aria-labelledby="newsletter-title">
  <h2 id="newsletter-title">Get the best of the Ozarks in your inbox</h2>
  <p>Trip ideas, new destinations, seasonal finds and useful planning tips. No cold-business outreach is added to this list.</p>
  <form method="post" action="/subscribe">
    <input type="hidden" name="source" value="homepage">
    <label for="newsletter-email">Email address</label>
    <input id="newsletter-email" type="email" name="email" autocomplete="email" required>
    <label><input type="checkbox" name="consent" value="true" required> I agree to receive OzarkRoost email updates. I can unsubscribe anytime.</label>
    <button type="submit">Send me OzarkRoost updates</button>
  </form>
</section>
